@using System.Security.Claims
@using Blazored.LocalStorage
@using WebDiary.Frontend.Models.Auth
@inject DiaryGroupClient DiaryGroupClient
@inject UserClient UserClient
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<Resources.LayoutResource> LocalizatorLayout
@inject IStringLocalizer<Resources.UsersResource> LocalizatorUsers
@inject IStringLocalizer<Resources.MainResource> LocalizatorMain
@inject ILocalStorageService localStorage
@inject NavigationManager NavigationManager
@inject HttpClient HttpClient
@rendermode InteractiveServer

<div class="app-nav">
    <div class="nav-header">
        <div class="nav-brand">
            <div class="nav-mark">WD</div>
            <div class="nav-brand-text">
                <span class="nav-title">WebDiary</span>
                @if(!string.IsNullOrWhiteSpace(topName)) {
                    <span class="nav-subtitle">@topName</span>
                }
            </div>
        </div>
    </div>

    <input type="checkbox" title="Navigation menu" class="nav-toggle" id="nav-toggle-main" />
    <label class="nav-toggle-label" for="nav-toggle-main" aria-label="Toggle navigation">
        <span></span>
    </label>

    <div class="nav-scrollable" onclick="document.querySelector('.nav-toggle').click()">
        <nav class="nav-list">
            <div class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <i class="bi bi-house-door-fill nav-icon" aria-hidden="true"></i>
                    <span>@LocalizatorLayout["HomeTitle"]</span>
                </NavLink>
            </div>

            <AuthorizeView>
                <Authorized>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/Users" Match="NavLinkMatch.All">
                            <i class="bi bi-person-circle nav-icon" aria-hidden="true"></i>
                            <span>@LocalizatorLayout["ManageTitle"]</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <button type="button" class="nav-link-button" @onclick="() => modalLogout!.Open()">
                            <i class="bi bi-box-arrow-right nav-icon" aria-hidden="true"></i>
                            <span>@LocalizatorLayout["LogoutTitle"]</span>
                        </button>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/Statistics" Match="NavLinkMatch.All">
                            <i class="bi bi-bar-chart-line nav-icon" aria-hidden="true"></i>
                            <span>@LocalizatorLayout["StatisticsTitle"]</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/EntriesSearch" Match="NavLinkMatch.All">
                            <i class="bi bi-search nav-icon" aria-hidden="true"></i>
                            <span>@LocalizatorLayout["SearchEntriesTitle"]</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/Chatrooms" Match="NavLinkMatch.All">
                            <i class="bi bi-chat-dots nav-icon" aria-hidden="true"></i>
                            <span>Chatrooms</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/ArchivedGroups" Match="NavLinkMatch.All">
                            <i class="bi bi-archive nav-icon" aria-hidden="true"></i>
                            <span>Archived Groups</span>
                        </NavLink>
                    </div>

                    <AuthorizeView Roles="Admin" Context="AdminContext">
                        <Authorized>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="/AdminPanel" Match="NavLinkMatch.All">
                                    <i class="bi bi-shield-star nav-icon" aria-hidden="true"></i>
                                    <span>@LocalizatorLayout["AdminPanelTitle"]</span>
                                </NavLink>
                            </div>
                        </Authorized>
                    </AuthorizeView>

                    <div class="nav-divider"></div>

                    @if(groups is null) {
                        <div class="nav-loading">@LocalizatorLayout["Loading"]</div>
                    } else {
                        @foreach(var group in groups!) {
                            <div class="nav-item nav-group">
                                <NavLink class="nav-link nav-group-link" href="@($"Diary/{group.Id}")" Match="NavLinkMatch.All">
                                    <i class="bi @(string.IsNullOrEmpty(group.PinCode) ? "bi-unlock" : "bi-lock-fill") nav-icon" aria-hidden="true"></i>
                                    <span class="nav-group-name">@group.Name</span>
                                    @if (group.OwnerId == loggedUserId)
                                    {
                                        <span class="nav-group-actions">
                                            <button type="button" class="nav-action" title="Pin code"
                                                @onclick="() => OpenPinGroup(group)" @onclick:preventDefault="true" @onclick:stopPropagation="true">
                                                <i class="bi bi-pin-angle" aria-hidden="true"></i>
                                            </button>
                                            <button type="button" class="nav-action" title="Edit group"
                                                @onclick="() => OpenPinChangeUpdating(group)" @onclick:preventDefault="true" @onclick:stopPropagation="true">
                                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                            </button>
                                            <button type="button" class="nav-action nav-action-warning" title="Archive group"
                                                @onclick="() => OpenArchiveConfirmation(group)" @onclick:preventDefault="true" @onclick:stopPropagation="true">
                                                <i class="bi bi-archive" aria-hidden="true"></i>
                                            </button>
                                            <button type="button" class="nav-action nav-action-danger" title="Delete group"
                                                @onclick="() => OpenPinChangeDeleting(group)" @onclick:preventDefault="true" @onclick:stopPropagation="true">
                                                <i class="bi bi-trash3" aria-hidden="true"></i>
                                            </button>
                                            @* "propagation" generally means the spreading or dissemination of information or changes through a system
                                                Here, @onclick:stopPropagation="true": Stops the event from bubbling up to parent elements
                                                While @onclick:preventDefault="true": Stops the browser's default action (the href navigation for an <a> tag).
                                            *@
                                        </span>
                                    }
                                </NavLink>
                            </div>
                        }
                    }
                    <div class="nav-item nav-cta">
                        <button class="btn btn-primary w-100" type="button" @onclick="() => OpenPinChange()">
                            <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>
                            <span>@LocalizatorLayout["NewDiaryGroupTitle"]</span>
                        </button>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/Users/Signin" Match="NavLinkMatch.All">
                            <i class="bi bi-person-plus nav-icon" aria-hidden="true"></i>
                            <span>@LocalizatorLayout["SigninTitle"]</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="/Users/Login" Match="NavLinkMatch.All">
                            <i class="bi bi-person-check nav-icon" aria-hidden="true"></i>
                            <span>@LocalizatorLayout["LoginTitle"]</span>
                        </NavLink>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
            @* DIALOGUE /// MODALS *@
            <DialogueTemplate @ref="modalChangeGroup" HeaderText=@HeaderName>
            <BodyTemplate>
                @if(!isDeleting) {
                    <p>@LocalizatorMain["CreateGroupVar1"]</p>
                    <InputText class="full-width" @bind-Value="group!.Name"></InputText>
                    @if(HeaderName == LocalizatorMain["AddThematicGroup"]) {
                        <p class="mt-3">@LocalizatorMain["ChangePinGroup1"]</p>
                        <InputText type="password" class="full-width" @bind-Value="group!.PinCode"></InputText>
                    }
                } else{
                    <p class="fs-5 fw-semibold text-danger">@LocalizatorMain["DeleteGroupPart1"]@group!.Name@LocalizatorMain["DeleteGroupPart2"]</p>
                }
            </BodyTemplate>
            <FooterTemplate>
                @if(!@isValidated) {
                    <p>@LocalizatorMain["NotValidatedText"]</p>
                }
                <button type="button" class="btn btn-secondary"
                    data-dismiss="modal" @onclick="() => modalChangeGroup!.Close()">@LocalizatorMain["CancelButtonText"]</button>
                <button type="button" class="btn btn-@(isDeleting ? "danger" : "primary") @(isValidated ? "" : "disabled")"
                    @onclick="SaveAsync">@(isDeleting ? LocalizatorMain["DeleteButtonText"] : LocalizatorMain["SaveButtonText"])</button>
            </FooterTemplate>
        </DialogueTemplate>

        <DialogueTemplate @ref="modalPin" HeaderText=@LocalizatorMain["AddPinHeader"]>
            <BodyTemplate>
                <p>@LocalizatorMain["ChangePinGroup1"]</p>
                <InputText type="password"  class="full-width" @bind-Value="group!.PinCode"></InputText>
                @if(firstPinExists) {
                    <p>@LocalizatorMain["ChangePinGroup2"]</p>
                    <InputText type="password" class="full-width" @bind-Value="writedFirstPin"></InputText>
                }
            </BodyTemplate>
            <FooterTemplate>
                <p class="fs-5 fw-semibold text-danger">@ErrorMessage</p>
                <button type="button" class="btn btn-secondary"
                    data-dismiss="modal" @onclick="() => modalPin!.Close()">@LocalizatorMain["CancelButtonText"]</button>
                <button type="button" class="btn btn-primary @(isValidated ? "" : "disabled")"
                    @onclick="SavePinCodeAsync">@LocalizatorMain["SaveButtonText"]</button>
            </FooterTemplate>
        </DialogueTemplate>

        <DialogueTemplate @ref="modalLogout" HeaderText=@LocalizatorUsers["Logout"]>
            <BodyTemplate>
                <p>@LocalizatorUsers["LogoutDialogueText"]</p>
            </BodyTemplate>
            <FooterTemplate>
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal" @onclick="() => modalLogout!.Close()">@LocalizatorUsers["CancelButtonText"]</button>
                <button type="button" class="btn btn-outline-danger" @onclick="LogoutUserAsync">@LocalizatorUsers["Logout"]</button>
            </FooterTemplate>
        </DialogueTemplate>

        <DialogueTemplate @ref="cookieAgreementModal" HeaderText=@LocalizatorLayout["CookieAgreeTitle"]>
            <BodyTemplate>
                <p>@LocalizatorLayout["CookieAgree"]</p>
            </BodyTemplate>
            <FooterTemplate>
                <button type="button" class="btn btn-outline-primary" @onclick="CloseCookieModal">@LocalizatorLayout["CookieAgreeButtonText"]</button>
            </FooterTemplate>
        </DialogueTemplate>

        <DialogueTemplate @ref="modalArchiveConfirm" HeaderText=@("Archive Group")>
            <BodyTemplate>
                <p class="fs-5">Are you sure you want to archive this group?</p>
                <p class="text-muted">You can unarchive it later from the Archived Groups page.</p>
            </BodyTemplate>
            <FooterTemplate>
                <button type="button" class="btn btn-secondary" data-dismiss="modal" @onclick="() => modalArchiveConfirm!.Close()">Cancel</button>
                <button type="button" class="btn btn-warning" @onclick="ArchiveGroupAsync">Archive</button>
            </FooterTemplate>
        </DialogueTemplate>

        </nav>
    </div>
</div>

@code {
    List<DiaryGroup>? groups;
    int loggedUserId;
    private string? topName;
    private DialogueTemplate? modalChangeGroup;
    private DialogueTemplate? modalPin;
    private DialogueTemplate? cookieAgreementModal;
    private DialogueTemplate? modalLogout;
    private DialogueTemplate? modalArchiveConfirm;
    [CascadingParameter] protected Task<AuthenticationState>? AuthStat { get; set; }

    protected async override Task OnInitializedAsync() {
        await base.OnInitializedAsync();
        var user = (await AuthStat!).User;
        if(user.Identity != null && user.Identity.IsAuthenticated) {
            loggedUserId = Convert.ToInt32(user.FindFirstValue("userId"));
            try {
                await UserClient.GetUserByIdAsync(loggedUserId);
            } catch (Exception Ex) {
                Log.Error("Exception of user nonexistance?: " + Ex);
                await ((CustomAuthenticationStateProvider)AuthenticationStateProvider).LogoutUserAsync();
            }
            groups = await DiaryGroupClient.GetGroupsOfUserAsync(loggedUserId);
            topName = user.Identity.Name;
            User userMain = await UserClient.GetUserByIdAsync(loggedUserId);
            isValidated = userMain.IsValidated;
        }
    }

    protected async override Task OnAfterRenderAsync(bool firstRender) {
        if(firstRender) {

            if(await localStorage.GetItemAsync<bool>("CookieAgreement") != true) {
                cookieAgreementModal?.Open();
            }

            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    // Methods of Modals
    DiaryGroup group { get; set; } = new() {Name = "", PinCode = "", OwnerUserName = ""};
    private bool firstPinExists;
    private string? writedFirstPin;
    private string ErrorMessage = "";
    private bool isValidated = true;
    private string HeaderName = "";
    private bool isDeleting = false;

    private async Task SavePinCodeAsync() {
        ArgumentNullException.ThrowIfNull(group);

        ErrorMessage = "";
        if(firstPinExists) {
            var response = await ((CustomAuthenticationStateProvider)AuthenticationStateProvider).AuthorizedRequestAsync(() =>
                HttpClient.PostAsJsonAsync($"/auth/pincode/verify?culture={CultureInfo.CurrentCulture}",
                    new { Pin = writedFirstPin, GroupId = group!.Id }));
            if(!response.IsSuccessStatusCode) {
                ErrorMessage = LocalizatorMain["ChangePinGroup3"];
                return;
            }
        }
        await DiaryGroupClient.UpdateGroupAsync(group);
        NavigationManager.NavigateTo("/", true);
    }
    private async Task SaveAsync() {
        ArgumentNullException.ThrowIfNull(group);
        if(HeaderName == LocalizatorMain["AddThematicGroup"]) {
            await DiaryGroupClient.AddGroupAsync(group);
            NavigationManager.NavigateTo("/", true);
        } else if(isDeleting) {
            await DiaryGroupClient.DeleteGroupAsync(group.Id);
            NavigationManager.NavigateTo("/", true);
        } else {
            await DiaryGroupClient.UpdateGroupAsync(group);
            NavigationManager.Refresh(true);
        }
    }
    private async void LogoutUserAsync() {
        await ((CustomAuthenticationStateProvider)AuthenticationStateProvider).LogoutUserAsync();
        NavigationManager.NavigateTo("/", true);
    }

    // CUSTOM OPENS AND CLOSING
    private async Task CloseCookieModal() {
        await localStorage.SetItemAsync("CookieAgreement", true);
        if(cookieAgreementModal != null)
            cookieAgreementModal.Close();
    }
    private void OpenPinGroup(DiaryGroup _group) {
        firstPinExists = !string.IsNullOrEmpty(_group.PinCode);
        group = _group;
        group.PinCode = "";
        if(modalPin != null)
            modalPin.Open();
    }
    public void OpenPinChange() {
        HeaderName = LocalizatorMain["AddThematicGroup"];
        group = new() {
            Name = "",
            OwnerId = loggedUserId
        };
        if(modalChangeGroup != null)
            modalChangeGroup.Open();
    }
    public void OpenPinChangeDeleting(DiaryGroup _group) {
        group = _group;
        isDeleting = true;
        HeaderName = $"{LocalizatorMain["DeletingGroupHeader"]}\"{group.Name}\"";
        if(modalChangeGroup != null)
            modalChangeGroup.Open();
    }
    public void OpenPinChangeUpdating(DiaryGroup _group) {
        group = _group;
        isDeleting = false;
        HeaderName = $"{LocalizatorMain["EditingGroupHeader"]}\"{group.Name}\"";
        if(modalChangeGroup != null)
            modalChangeGroup.Open();
    }

    private void OpenArchiveConfirmation(DiaryGroup _group) {
        group = _group;
        if(modalArchiveConfirm != null)
            modalArchiveConfirm.Open();
    }

    private async Task ArchiveGroupAsync() {
        ArgumentNullException.ThrowIfNull(group);
        group.IsArchived = true;
        await DiaryGroupClient.UpdateGroupAsync(group);
        if(modalArchiveConfirm != null)
            modalArchiveConfirm.Close();
        NavigationManager.Refresh(true);
    }

}
