@using System.Security.Claims
@using Blazored.LocalStorage
@using WebDiary.Frontend.Models.Auth
@inject DiaryGroupClient DiaryGroupClient
@inject UserClient UserClient
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<Resources.LayoutResource> LocalizatorLayout
@inject IStringLocalizer<Resources.UsersResource> LocalizatorUsers
@inject IStringLocalizer<Resources.MainResource> LocalizatorMain
@inject ILocalStorageService localStorage
@inject NavigationManager NavigationManager
@inject HttpClient HttpClient
@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@topName</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3 d-flex">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="biLocal bi-house-door-fill-nav-menu" aria-hidden="true"></span> @LocalizatorLayout["HomeTitle"]
            </NavLink>
        </div>

        <AuthorizeView Context="navbarContext">
            <Authorized>
                <div class="nav-item px-3 d-flex">
                    <NavLink class="nav-link" href="/Users" Match="NavLinkMatch.All">
                        <span class="biLocal bi-person-fill-nav-menu" aria-hidden="true"></span> @LocalizatorLayout["ManageTitle"]
                    </NavLink>
                </div>
                <div class="nav-item px-3 d-flex">
                    <NavLink class="nav-link" @onclick="() => modalLogout!.Open()" Match="NavLinkMatch.All">
                        <span class="biLocal bi-person-dash-nav-menu" aria-hidden="true"></span> @LocalizatorLayout["LogoutTitle"]
                    </NavLink>
                </div>
                <div class="nav-item px-3 d-flex">
                    <NavLink class="nav-link" href="/Statistics" Match="NavLinkMatch.All">
                        <span class="bi bi-bar-chart-line me-3" aria-hidden="true"></span>   @LocalizatorLayout["StatisticsTitle"]
                    </NavLink>
                </div>

                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <div class="nav-item px-3 d-flex">
                            <NavLink class="nav-link" href="/AdminPanel" Match="NavLinkMatch.All">
                                <span class="bi bi-award-fill me-3" aria-hidden="true"></span>   @LocalizatorLayout["AdminPanelTitle"]
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>

            @if(groups is null) {
                <p>@LocalizatorLayout["Loading"]</p>
            } else {
                @foreach(var group in groups!) {
                    <div class="nav-item px-3 d-flex">
                        <NavLink class="nav-link" href="@($"Diary/{group.Id}")" Match="NavLinkMatch.All">
                            <span class="bi bi-lock@(String.IsNullOrEmpty(group.PinCode) ? @"" : @"-fill")" />
                            <p class="mt-3 truncated-group-header">@group.Name</p>
                            <div class="d-flex position-buttons">
                                <button type="button" class="btn btn-secondary biLocal bi-pin-code"
                                    @onclick="() => OpenPinGroup(group)" @onclick:preventDefault="true" @onclick:stopPropagation="true"/>
                                <button type="button" class="btn btn-secondary biLocal bi-pencil-square-black-nav-menu"
                                    @onclick="() => OpenPinChangeUpdating(group)" @onclick:preventDefault="true" @onclick:stopPropagation="true"/>
                                <button type="button" class="btn btn-danger btn-close"
                                    @onclick="() => OpenPinChangeDeleting(group)" @onclick:preventDefault="true" @onclick:stopPropagation="true"/>
                                @* "propagation" generally means the spreading or dissemination of information or changes through a system
                                    Here, @onclick:stopPropagation="true": Stops the event from bubbling up to parent elements
                                    While @onclick:preventDefault="true": Stops the browser's default action (the href navigation for an <a> tag).
                                *@
                            </div>
                        </NavLink>
                    </div>
                }
            }
            <div class="nav-item px-3 d-flex">
                <button class="btn btn-primary transparent-color" type="button" @onclick="() => OpenPinChange()">
                    <span class="biLocal bi-pencil-square-nav-menu" aria-hidden="true" /> @LocalizatorLayout["NewDiaryGroupTitle"]
                </button>
            </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3 d-flex">
                    <NavLink class="nav-link" href="/Users/Signin" Match="NavLinkMatch.All">
                        <span class="biLocal bi-person-add-nav-menu" aria-hidden="true"></span> @LocalizatorLayout["SigninTitle"]
                    </NavLink>
                </div>
                <div class="nav-item px-3 d-flex">
                    <NavLink class="nav-link" href="/Users/Login" Match="NavLinkMatch.All">
                        <span class="biLocal bi-person-check-nav-menu" aria-hidden="true"></span> @LocalizatorLayout["LoginTitle"]
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
        @* DIALOGUE /// MODALS *@
        <DialogueTemplate @ref="modalChangeGroup" HeaderText=@HeaderName>
            <BodyTemplate>
                @if(!isDeleting) {
                    <p>@LocalizatorMain["CreateGroupVar1"]</p>
                    <InputText class="full-width" @bind-Value="group!.Name"></InputText>
                    @if(HeaderName == LocalizatorMain["AddThematicGroup"]) {
                        <p class="mt-3">@LocalizatorMain["ChangePinGroup1"]</p>
                        <InputText type="password" class="full-width" @bind-Value="group!.PinCode"></InputText>
                    }
                } else{
                    <p class="fs-5 fw-semibold text-danger">@LocalizatorMain["DeleteGroupPart1"]@group!.Name@LocalizatorMain["DeleteGroupPart2"]</p>
                }
            </BodyTemplate>
            <FooterTemplate>
                @if(!@isValidated) {
                    <p>@LocalizatorMain["NotValidatedText"]</p>
                }
                <button type="button" class="btn btn-secondary"
                    data-dismiss="modal" @onclick="() => modalChangeGroup!.Close()">@LocalizatorMain["CancelButtonText"]</button>
                <button type="button" class="btn btn-@(isDeleting ? "danger" : "primary") @(isValidated ? "" : "disabled")"
                    @onclick="SaveAsync">@(isDeleting ? LocalizatorMain["DeleteButtonText"] : LocalizatorMain["SaveButtonText"])</button>
            </FooterTemplate>
        </DialogueTemplate>

        <DialogueTemplate @ref="modalPin" HeaderText=@LocalizatorMain["AddPinHeader"]>
            <BodyTemplate>
                <p>@LocalizatorMain["ChangePinGroup1"]</p>
                <InputText type="password"  class="full-width" @bind-Value="group!.PinCode"></InputText>
                @if(firstPinExists) {
                    <p>@LocalizatorMain["ChangePinGroup2"]</p>
                    <InputText type="password" class="full-width" @bind-Value="writedFirstPin"></InputText>
                }
            </BodyTemplate>
            <FooterTemplate>
                <p class="fs-5 fw-semibold text-danger">@ErrorMessage</p>
                <button type="button" class="btn btn-secondary"
                    data-dismiss="modal" @onclick="() => modalPin!.Close()">@LocalizatorMain["CancelButtonText"]</button>
                <button type="button" class="btn btn-primary @(isValidated ? "" : "disabled")"
                    @onclick="SavePinCodeAsync">@LocalizatorMain["SaveButtonText"]</button>
            </FooterTemplate>
        </DialogueTemplate>

        <DialogueTemplate @ref="modalLogout" HeaderText=@LocalizatorUsers["Logout"]>
            <BodyTemplate>
                <p>@LocalizatorUsers["LogoutDialogueText"]</p>
            </BodyTemplate>
            <FooterTemplate>
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal" @onclick="() => modalLogout!.Close()">@LocalizatorUsers["CancelButtonText"]</button>
                <button type="button" class="btn btn-outline-danger" @onclick="LogoutUserAsync">@LocalizatorUsers["Logout"]</button>
            </FooterTemplate>
        </DialogueTemplate>

        <DialogueTemplate @ref="cookieAgreementModal" HeaderText=@LocalizatorLayout["CookieAgreeTitle"]>
            <BodyTemplate>
                <p>@LocalizatorLayout["CookieAgree"]</p>
            </BodyTemplate>
            <FooterTemplate>
                <button type="button" class="btn btn-outline-primary" @onclick="CloseCookieModal">@LocalizatorLayout["CookieAgreeButtonText"]</button>
            </FooterTemplate>
        </DialogueTemplate>

    </nav>
</div>

@code {
    List<DiaryGroup>? groups;
    int loggedUserId;
    private string? topName;
    private DialogueTemplate? modalChangeGroup;
    private DialogueTemplate? modalPin;
    private DialogueTemplate? cookieAgreementModal;
    private DialogueTemplate? modalLogout;
    [CascadingParameter] protected Task<AuthenticationState>? AuthStat { get; set; }

    protected async override Task OnInitializedAsync() {
        topName = "Smart diary";
        await base.OnInitializedAsync();
        var user = (await AuthStat!).User;
        if(user.Identity != null && user.Identity.IsAuthenticated) {
            loggedUserId = Convert.ToInt32(user.FindFirstValue("userId"));
            try {
                await UserClient.GetUserByIdAsync(loggedUserId);
            } catch (Exception Ex) {
                Log.Error("Exception of user nonexistance?: " + Ex);
                await ((CustomAuthenticationStateProvider)AuthenticationStateProvider).LogoutUserAsync();
            }
            groups = await DiaryGroupClient.GetGroupsOfUserAsync(loggedUserId);
            topName = user.Identity.Name;
            User userMain = await UserClient.GetUserByIdAsync(loggedUserId);
            isValidated = userMain.IsValidated;
        }
    }

    protected async override Task OnAfterRenderAsync(bool firstRender) {
        if(firstRender) {

            if(await localStorage.GetItemAsync<bool>("CookieAgreement") != true) {
                cookieAgreementModal?.Open();
            }

            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    // Methods of Modals
    DiaryGroup group { get; set; } = new() {Name = "", PinCode = ""};
    private bool firstPinExists;
    private string? writedFirstPin;
    private string ErrorMessage = "";
    private bool isValidated = true;
    private string HeaderName = "";
    private bool isDeleting = false;

    private async Task SavePinCodeAsync() {
        ArgumentNullException.ThrowIfNull(group);

        ErrorMessage = "";
        if(firstPinExists) {
            var response = (await HttpClient.GetAsync($"/auth/pincode/isequal/{writedFirstPin}/{group!.Id}?culture={CultureInfo.CurrentCulture}"));
            if(!response.IsSuccessStatusCode) {
                ErrorMessage = LocalizatorMain["ChangePinGroup3"];
                return;
            }
        }
        await DiaryGroupClient.UpdateGroupAsync(group);
        NavigationManager.NavigateTo("/", true);
    }
    private async Task SaveAsync() {
        ArgumentNullException.ThrowIfNull(group);
        if(HeaderName == LocalizatorMain["AddThematicGroup"]) {
            await DiaryGroupClient.AddGroupAsync(group);
            NavigationManager.NavigateTo("/", true);
        } else if(isDeleting) {
            await DiaryGroupClient.DeleteGroupAsync(group.Id);
            NavigationManager.NavigateTo("/", true);
        } else {
            await DiaryGroupClient.UpdateGroupAsync(group);
            NavigationManager.Refresh(true);
        }
    }
    private async void LogoutUserAsync() {
        await ((CustomAuthenticationStateProvider)AuthenticationStateProvider).LogoutUserAsync();
        NavigationManager.NavigateTo("/", true);
    }

    // CUSTOM OPENS AND CLOSING
    private async Task CloseCookieModal() {
        await localStorage.SetItemAsync("CookieAgreement", true);
        if(cookieAgreementModal != null)
            cookieAgreementModal.Close();
    }
    private async Task OpenPinGroup(DiaryGroup _group) {
        firstPinExists = !string.IsNullOrEmpty(_group.PinCode);
        group = _group;
        group.PinCode = "";
        if(modalPin != null)
            modalPin.Open();
    }
    public void OpenPinChange() {
        HeaderName = LocalizatorMain["AddThematicGroup"];
        group = new() {
            Name = "",
            UserId = loggedUserId
        };
        if(modalChangeGroup != null)
            modalChangeGroup.Open();
    }
    public void OpenPinChangeDeleting(DiaryGroup _group) {
        group = _group;
        isDeleting = true;
        HeaderName = $"{LocalizatorMain["DeletingGroupHeader"]}\"{group.Name}\"";
        if(modalChangeGroup != null)
            modalChangeGroup.Open();
    }
    public void OpenPinChangeUpdating(DiaryGroup _group) {
        group = _group;
        isDeleting = false;
        HeaderName = $"{LocalizatorMain["EditingGroupHeader"]}\"{group.Name}\"";
        if(modalChangeGroup != null)
            modalChangeGroup.Open();
    }

}