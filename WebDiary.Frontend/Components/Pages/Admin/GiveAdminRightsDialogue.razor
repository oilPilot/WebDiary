@inject IStringLocalizer<Resources.AdminResource> Localizator
@inject UserClient userClient

<div class="modal" tabindex="-1" style="display: @ModalDisplay;">
    <div class="modal-dialogue" role="document">
        <div class="modal-placement modal-content">
            <div class="modal-header">
                <h4 class="modal-title">@Localizator["GiveAdminRightsDialogue1"]</h4>
                <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close" @onclick="() => Close()" />
            </div>
            <div class="modal-body">
                <p>@Localizator["GiveAdminRightsDialogue2"]@User.UserName@Localizator["GiveAdminRightsDialogue3"]</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                    data-dismiss="modal" @onclick="() => Close()">@Localizator["CancelButtonText"]</button>
                <button type="button" class="btn btn-primary" @onclick="SaveAsync">@Localizator["ContinueButton"]</button>
            </div>
        </div>
    </div>
</div>

@if (ShowBackdrop)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    public User User = new User() { UserName = ""};
    public string ModalDisplay = "none;";
    public bool ShowBackdrop = false;

    private async Task SaveAsync() {
        var newUser = User;
        newUser.Role = "Admin";
        await userClient.UpdateUserAsync(newUser);
    }

    public void Open(User user) {
        ModalDisplay = "block;";
        ShowBackdrop = true;
        User = user;
        StateHasChanged();
    }
    private void Close() {
        ModalDisplay = "none;";
        ShowBackdrop = false;
        StateHasChanged();
    }

}
