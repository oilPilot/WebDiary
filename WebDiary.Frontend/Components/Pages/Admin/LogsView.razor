@using Serilog
@inject LogRecordClient logsClient
@inject IStringLocalizer<Resources.AdminResource> Localizator

<div class="mt-4 mb-4 d-flex flex-wrap align-items-center">
    <div class="mt-2">
        @Localizator["FilterSet8"]
        <InputNumber class="form-full-width ms-2" @bind-value="countTake"
            aria-placeholder="@Localizator[@"FilterSet8"]" style="width: auto;" />
    </div>
    <div class="mt-2 ms-2">
        @Localizator["FilterSet7"]
        <InputSelect class="form-full-width ms-2" @bind-value="LevelFilter" style="width: auto;">
            @* <option value=0>Verbose</option>
            <option value=1>Debug</option>
            These two logs are not saved and never showcased *@
            <option value=2>Information</option>
            <option value=3>Warning</option>
            <option value=4>Error</option>
            <option value=5>Fatal</option>
        </InputSelect>
    </div>
    <div class="mt-2 ms-2">
        @Localizator["FilterSet6"]
        <InputDate class="form-full-width ms-2" @bind-value="DateFilter" aria-placeholder="@Localizator[@"FilterSet6"]" style="width: auto;" />
    </div>
    <div class="mt-2 ms-2">
        @Localizator["FilterSet9"]
        <InputText class="form-full-width ms-2" @bind-value="MessageFilter" aria-placeholder="@Localizator[@"FilterSet9"]" style="width: auto;" />
    </div>
    <div class="mt-2 ms-2">
        <button type="submit" class="btn btn-secondary" @onclick="() => UpdateSearch()">@Localizator["FilterSet3"]</button>
        <button type="submit" class="btn btn-danger" @onclick="() => ClearLogs()">@Localizator["LogsClear"]</button>
    </div>
</div>

<TableTemplate Items="logsSearching" CssClassesToAdd="table-to-bottom-scroll-y" >
    <TableHeader>
        <th>@Localizator["TableLogsHeader1"]</th>
        <th>@Localizator["TableLogsHeader2"]</th>
        <th>@Localizator["TableLogsHeader3"]</th>
        <th>@Localizator["TableLogsHeader4"]</th>
        @* DO NOT SHOW PROPERTIES - IT'S JSON TEXT THAT IS ONLY FOR DEV PURPOSES *@
    </TableHeader>
    <RowTemplate Context="logs">
        <td>@logs.level</td>
        <td>@logs.Timestamp</td>
        <td>@logs.Message</td>
        <td>@logs.Exception</td>
    </RowTemplate>

</TableTemplate>

@code {
    List<LogRecord>? logs { get; set; }
    List<LogRecord>? logsSearching { get; set; }
    // Filter data
    private int? countTake = 100;
    private int LevelFilter = 2;
    private DateOnly? DateFilter = null;
    private string? MessageFilter = null;
    // For logging actions done by Admin
    private string? adminId;
    private string? adminUserName;
    [CascadingParameter] protected Task<AuthenticationState>? AuthStat { get; set; }

    protected async override Task OnInitializedAsync()
    {
        base.OnInitialized();
        logs = await logsClient.GetLogRecordsAsync(countTake!.Value);
        await UpdateSearch();
        var user = (await AuthStat!).User;
        adminId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        adminUserName = user.FindFirst(ClaimTypes.Name)?.Value;
    }

    private async Task ClearLogs() {
        await logsClient.ClearLogsAsync();
        Log.Warning("Admin with Username '{AdminName}' & id '{AdminId}'" +
                        " had cleared all logs.", adminUserName, adminId);
        await UpdateSearch();
    }

    private async Task UpdateSearch() {
        logs = await logsClient.GetLogRecordsAsync(countTake.Value);
        logsSearching = logs!;

        if(LevelFilter != 2)
            logsSearching = logsSearching.Where(logRecord => logRecord.levelInt >= LevelFilter).ToList();
        if(DateFilter != null)
            logsSearching = logsSearching.Where(logRecord => DateOnly.FromDateTime(logRecord.Timestamp) == DateFilter).ToList();
        if(!String.IsNullOrEmpty(MessageFilter))
            logsSearching = logsSearching.Where(logRecord => logRecord.Message.Contains(MessageFilter)).ToList();
        
        StateHasChanged();
    }

}
