@inject IJSRuntime JS
@inject DiaryGroupClient DiaryGroupClient
@inject HttpClient HttpClient
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<Resources.SettingsResource> Localizator

<p style="margin-top: 10px;">@Localizator["SavePDFText"]</p>
<select class="ms-2" @bind="selectedGroupId">
    <option value="0">@Localizator["MainSavePDFOption"]</option>
    @if(groups != null) {
        @foreach(DiaryGroup group in groups) {
            <option value="@group.Id">@group.Name</option>
        }
    }
</select>
<button class="btn btn-secondary ms-2" @onclick="SaveAsPdf">@Localizator["SavePDFButton"]</button>

@code {
    List<DiaryGroup>? groups;
    int loggedUserId;
    int selectedGroupId;
    [CascadingParameter] protected Task<AuthenticationState>? AuthStat { get; set; }
    
    protected async override Task OnInitializedAsync() {
        await base.OnInitializedAsync();
        var user = (await AuthStat!).User;
        if(user.Identity != null && user.Identity.IsAuthenticated) {
            loggedUserId = Convert.ToInt32(user.FindFirstValue("userId"));
            groups = await DiaryGroupClient.GetGroupsOfUserAsync(loggedUserId);
        }
    }

    private async Task SaveAsPdf() {
        if(selectedGroupId == 0) {
//            await JS.InvokeVoidAsync("open", $"{HttpClient.BaseAddress}export/all/{loggedUserId}", "_blank");
            var url = $"{HttpClient.BaseAddress}export/all/{loggedUserId}";
            await JS.InvokeVoidAsync("downloadDiaryPdf", url);

        } else {
//            await JS.InvokeVoidAsync("open", $"{HttpClient.BaseAddress}export/certain/{selectedGroupId}", "_blank");
            var url = $"{HttpClient.BaseAddress}export/certain/{selectedGroupId}";
            await JS.InvokeVoidAsync("downloadDiaryPdf", url);
        }
    }
}
