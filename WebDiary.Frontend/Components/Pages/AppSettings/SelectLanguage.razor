@using System.Globalization
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject IStringLocalizer<Resources.SettingsResource> Localizator

<div class="settings-card">
    <div class="settings-content">
        <span class="settings-title">@Localizator["LanguageText"]</span>
    </div>
    <div class="settings-actions">
        <InputSelect class="form-select settings-select"
                     @bind-Value="_cultureName"
                     @bind-Value:after="OnCultureChangedAsync">
            <option value="en">@Localizator["LanguageEng"]</option>
            <option value="de">@Localizator["LanguageGer"]</option>
        </InputSelect>
    </div>
</div>

@code {
    private const string DefaultCulture = "en";
    private string _cultureName = DefaultCulture;

    protected override void OnInitialized()
    {
        _cultureName = CultureInfo.CurrentCulture.TwoLetterISOLanguageName switch
        {
            "de" => "de",
            _ => DefaultCulture
        };
    }

    private async Task OnCultureChangedAsync()
    {
        if (string.IsNullOrWhiteSpace(_cultureName))
            return;

        var culture = new CultureInfo(_cultureName);
        CultureInfo.CurrentCulture = culture;
        CultureInfo.CurrentUICulture = culture;
        CultureInfo.DefaultThreadCurrentCulture = culture;
        CultureInfo.DefaultThreadCurrentUICulture = culture;

        await JS.InvokeVoidAsync("setCulture", culture.Name);
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }
}
