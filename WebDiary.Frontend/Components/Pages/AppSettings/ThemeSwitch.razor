@inject IJSRuntime JS
@inject IStringLocalizer<Resources.LayoutResource> Localizator

<div class="settings-card">
    <div class="settings-content">
        <span class="settings-title">@($"{Localizator["LightThemeText"]} / {Localizator["DarkThemeText"]}")</span>
    </div>
    <div class="settings-actions">
        <BootstrapBlazor.Components.SwitchButton ToggleState="@(currentTheme == "dark" ? true : false)" class="settings-toggle"
            OnText="@(Localizator[@"DarkThemeText"])" OffText="@(Localizator[@"LightThemeText"])" @onclick="ChangeTheme" />
    </div>
</div>

@code {
    private string currentTheme = "dark";
    
    protected async override Task OnAfterRenderAsync(bool firstRender) {
        if(firstRender) {
            currentTheme = await JS.InvokeAsync<string>("getTheme");
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task ChangeTheme() {
        if(currentTheme == "dark") {
            currentTheme = "light";
        }
        else {
            currentTheme = "dark";
        }
        await JS.InvokeVoidAsync("toggleTheme", currentTheme);
        StateHasChanged();
    }
}
