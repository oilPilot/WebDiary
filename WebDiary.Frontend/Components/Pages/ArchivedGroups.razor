@page "/ArchivedGroups"
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using WebDiary.Frontend.Models.Auth
@inject DiaryGroupClient DiaryGroupClient
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Archived Groups</PageTitle>

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="card shadow">
                <div class="card-header bg-danger-subtle border-bottom">
                    <h3 class="mb-0">
                        <span class="bi bi-archive me-2"></span>Archived Groups
                    </h3>
                </div>
                <div class="card-body">
                    @if (archivedGroups == null)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-3 text-muted">Loading archived groups...</p>
                        </div>
                    }
                    else if (archivedGroups.Count == 0)
                    {
                        <div class="alert alert-info" role="alert">
                            <span class="bi bi-info-circle me-2"></span>
                            No archived groups yet. Your archived groups will appear here.
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var group in archivedGroups)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-bottom">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">
                                            <span class="bi bi-lock@(String.IsNullOrEmpty(group.PinCode) ? @"" : @"-fill")"></span>
                                            @group.Name
                                        </h6>
                                        <small class="text-muted">ID: @group.Id</small>
                                    </div>
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => ViewGroupDetails(group)" title="View Details">
                                            <span class="bi bi-eye"></span> View
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => OpenDearchiveConfirmation(group)" title="Restore Group">
                                            <span class="bi bi-arrow-counterclockwise"></span> Restore
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="card-footer bg-light">
                    <a href="/" class="btn btn-secondary">
                        <span class="bi bi-arrow-left me-2"></span>Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@* Group Details Modal *@
<div class="modal @(showDetailsModal ? "show d-block" : "")" tabindex="-1" style="background-color: @(showDetailsModal ? "rgba(0,0,0,0.5)" : "transparent");">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Group Details</h5>
                <button type="button" class="btn-close" @onclick="CloseDetailsModal"></button>
            </div>
            <div class="modal-body">
                @if (selectedGroup != null)
                {
                    <div>
                        <p><strong>Name:</strong> @selectedGroup.Name</p>
                        <p><strong>ID:</strong> @selectedGroup.Id</p>
                        <p><strong>Protected:</strong> @(string.IsNullOrEmpty(selectedGroup.PinCode) ? "No" : "Yes (PIN Code Set)")</p>
                        <p><strong>Status:</strong> <span class="badge bg-warning">Archived</span></p>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseDetailsModal">Close</button>
                <button type="button" class="btn btn-success" @onclick="() => DearchiveGroupAsync(selectedGroup)">
                    <span class="bi bi-arrow-counterclockwise me-2"></span>Restore This Group
                </button>
            </div>
        </div>
    </div>
</div>

@* Dearchive Confirmation Modal *@
<div class="modal @(showDearchiveModal ? "show d-block" : "")" tabindex="-1" style="background-color: @(showDearchiveModal ? "rgba(0,0,0,0.5)" : "transparent");">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success-subtle">
                <h5 class="modal-title">Restore Archived Group</h5>
                <button type="button" class="btn-close" @onclick="CloseDearchiveModal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to restore <strong>@selectedGroup?.Name</strong>?</p>
                <p class="text-muted">This group will be visible in your groups list again.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseDearchiveModal">Cancel</button>
                <button type="button" class="btn btn-success" @onclick="() => ConfirmDearchiveAsync(selectedGroup)">
                    <span class="bi bi-arrow-counterclockwise me-2"></span>Restore Group
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<DiaryGroup> archivedGroups = new();
    private DiaryGroup? selectedGroup;
    private bool showDetailsModal = false;
    private bool showDearchiveModal = false;
    private int loggedUserId;

    [CascadingParameter] protected Task<AuthenticationState>? AuthStat { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthStat!).User;
            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                loggedUserId = Convert.ToInt32(user.FindFirstValue("userId"));
                await LoadArchivedGroupsAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading archived groups: {ex.Message}");
        }
    }

    private async Task LoadArchivedGroupsAsync()
    {
        try
        {
            archivedGroups = await DiaryGroupClient.GetArchivedGroupsAsync(loggedUserId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching archived groups: {ex.Message}");
        }
    }

    private void ViewGroupDetails(DiaryGroup group)
    {
        selectedGroup = group;
        showDetailsModal = true;
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedGroup = null;
    }

    private void OpenDearchiveConfirmation(DiaryGroup group)
    {
        selectedGroup = group;
        showDetailsModal = false;
        showDearchiveModal = true;
    }

    private void CloseDearchiveModal()
    {
        showDearchiveModal = false;
        selectedGroup = null;
    }

    private async Task DearchiveGroupAsync(DiaryGroup? group)
    {
        if (group == null) return;
        
        selectedGroup = group;
        showDetailsModal = false;
        showDearchiveModal = true;
    }

    private async Task ConfirmDearchiveAsync(DiaryGroup? group)
    {
        if (group == null) return;

        try
        {
            group.IsArchived = false;
            await DiaryGroupClient.UpdateGroupAsync(group);
            
            CloseDearchiveModal();
            NavigationManager.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error dearchiving group: {ex.Message}");
        }
    }
}
