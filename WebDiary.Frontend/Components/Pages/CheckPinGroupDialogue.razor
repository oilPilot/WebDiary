@using System.Security.Claims
@using System.Text.RegularExpressions
@inject DiaryGroupClient DiaryGroupClient
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Resources.MainResource> Localizator

<div class="modal" tabindex="-1" style="display: @ModalDisplay;">
    <div class="modal-dialogue" role="document">
        <div class="modal-placement modal-content">
            <div class="modal-header">
                <h4 class="modal-title">@HeaderName</h4>
                <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close" @onclick="() => Close()" />
            </div>
            <div class="modal-body">
                <p>@Localizator["CheckPinGroup1"]</p>
                <InputText type="password"  class="full-width" @bind-Value="PinCode"></InputText>
            </div>
            <div class="modal-footer">
                <p class="fs-5 fw-semibold text-danger">@ErrorMessage</p>
                <button type="button" class="btn btn-primary"
                    @onclick="SaveAsync">@Localizator["EnterButtonText"]</button>
            </div>
        </div>
    </div>
</div>

@if (ShowBackdrop)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    [SupplyParameterFromForm]
    DiaryGroup? group { get; set; }
    [Parameter]
    public EventCallback OnSuccess { get; set;}
    public string ModalDisplay = "none;";
    public bool ShowBackdrop = false;
    private string? HeaderName;
    private string? PinCode;
    private string? ErrorMessage;

    protected async override Task OnInitializedAsync() {
        group = new() {
            Name = ""
        };

        await base.OnInitializedAsync();
    }
    /* No need to extract validation (not exists)
    protected async override Task OnAfterRenderAsync(bool firstRender) {
        if(firstRender) {

            var loggedUser = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

            if(loggedUser.Identity != null && loggedUser.Identity.IsAuthenticated) {
                int loggedUserId = Convert.ToInt32(loggedUser.FindFirstValue("userId"));
                User user = await UserClient.GetUserByIdAsync(loggedUserId);
                isValidated = user.IsValidated;
            }

            StateHasChanged();
        }
        
        await base.OnAfterRenderAsync(firstRender);
    }
    */

    private async Task SaveAsync() {
        ArgumentNullException.ThrowIfNull(group);

        if(group.PinCode != PinCode) {
            ErrorMessage = "PIN-Code is Incorrect.";
            return;
        }
        await OnSuccess.InvokeAsync();
        Close();
    }

    public void Open(DiaryGroup _group) {
        ModalDisplay = "block;";
        ShowBackdrop = true;
        HeaderName = "Check pin for group";
        group = _group;
        StateHasChanged();
    }
    private void Close() {
        ModalDisplay = "none;";
        ShowBackdrop = false;
        StateHasChanged();
    }

}
