@page "/"
@using Blazored.SessionStorage
@inject IStringLocalizer<Resources.MainResource> Localizator
@inject HttpClient HttpClient
@inject ISessionStorageService sessionStorage

<PageTitle>MyDiary</PageTitle>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="text-center mb-5">
                <AuthorizeView>
                    <Authorized>
                        <div class="hero-section bg-primary text-white rounded-3 p-4 mb-4 shadow">
                            <h1 class="display-4 fw-bold mb-2">
                                <i class="bi bi-journal-bookmark-fill me-3"></i>
                                @Localizator["HomeHeadAuth"]@context.User.Identity!.Name!
                            </h1>
                            <p class="lead mb-0">Welcome back to your personal diary space</p>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="hero-section bg-gradient text-primary rounded-3 p-4 mb-4 shadow">
                            <h1 class="display-4 fw-bold mb-2">
                                <i class="bi bi-journal-text me-3"></i>
                                @Localizator["HomeHeadNonAuth"]
                            </h1>
                            <p class="lead mb-0">Start your journey of self-reflection and growth</p>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>

            <!-- Settings Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-gear-fill text-primary me-2"></i>
                        @Localizator["SettingsText"]
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-translate text-info me-2"></i>
                            <SelectLanguage />
                        </div>
                        <div class="vr d-none d-md-block"></div>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-palette-fill text-warning me-2"></i>
                            <ThemeSwitch />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Experimental Features Card -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-flask text-warning me-2"></i>
                        @Localizator["ExperimentalSettingsText"]
                    </h5>
                </div>
                <div class="card-body">
                    <AuthorizeView>
                        <Authorized>
                            <div class="d-flex align-items-center">
                                <i class="bi bi-file-earmark-pdf-fill text-danger me-2"></i>
                                <ExperimentalPDFsave />
                            </div>
                            <small class="text-muted mt-2">
                                <i class="bi bi-info-circle me-1"></i>
                                Try our experimental PDF export feature
                            </small>
                        </Authorized>
                        <NotAuthorized>
                            <div class="alert alert-info mb-0">
                                <i class="bi bi-lock-fill me-2"></i>
                                <strong>@Localizator["ExperimentalSettingsNonAuth"]</strong>
                                <br>
                                <small>Please sign in to access experimental features</small>
                            </div>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>

            <!-- Quick Actions for Authenticated Users -->
            <AuthorizeView>
                <Authorized>
                    <div class="card shadow-sm mt-4">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-lightning-charge-fill text-success me-2"></i>
                                Quick Actions
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-6 col-md-3">
                                    <a href="/Statistics" class="btn btn-outline-info w-100 d-flex flex-column align-items-center py-3">
                                        <i class="bi bi-bar-chart-line fs-4 mb-1"></i>
                                        <small>View Stats</small>
                                    </a>
                                </div>
                                <div class="col-6 col-md-3">
                                    <a href="/Users" class="btn btn-outline-secondary w-100 d-flex flex-column align-items-center py-3">
                                        <i class="bi bi-person-gear fs-4 mb-1"></i>
                                        <small>Account</small>
                                    </a>
                                </div>
                                <div class="col-6 col-md-3">
                                    <button @onclick="OpenMasterPasswordModal" class="btn btn-outline-warning w-100 d-flex flex-column align-items-center py-3">
                                        <i class="bi bi-key-fill fs-4 mb-1"></i>
                                        <small>Master Password</small>
                                    </button>
                                </div>
                                <div class="col-6 col-md-3">
                                    <a href="/Chatrooms" class="btn btn-outline-primary w-100 d-flex flex-column align-items-center py-3">
                                        <i class="bi bi-chat-dots-fill fs-4 mb-1"></i>
                                        <small>Chatrooms</small>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>

            <!-- Master Password Modal -->
            <DialogueTemplate @ref="masterPasswordModal" HeaderText="Global Master Password">
                <BodyTemplate>
                    @if (string.IsNullOrEmpty(masterPassword))
                    {
                        <p>Set a global master password to unlock all your groups with PINs in one go.</p>
                        <InputText type="password" class="form-control" @bind-Value="newMasterPassword" placeholder="Enter new master password" />
                    }
                    else
                    {
                        <p>Enter your global master password to unlock all groups for this session.</p>
                        <InputText type="password" class="form-control" @bind-Value="enteredMasterPassword" placeholder="Enter master password" />
                    }
                </BodyTemplate>
                <FooterTemplate>
                    <p class="fs-5 fw-semibold text-danger">@masterPasswordError</p>
                    @if (string.IsNullOrEmpty(masterPassword))
                    {
                        <button type="button" class="btn btn-primary" @onclick="SetMasterPasswordAsync">Set Password</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" @onclick="VerifyMasterPasswordAsync">Unlock All</button>
                        <button type="button" class="btn btn-secondary" @onclick="StartEditMasterPassword">Edit Password</button>
                    }
                    <button type="button" class="btn btn-secondary" @onclick="CloseMasterPasswordModal">Cancel</button>
                </FooterTemplate>
            </DialogueTemplate>
        </div>
    </div>
</div>

@code {
    private DialogueTemplate? masterPasswordModal;
    private string? masterPassword;
    private string newMasterPassword = "";
    private string enteredMasterPassword = "";
    private string masterPasswordError = "";

    protected override async Task OnInitializedAsync()
    {
        await CheckMasterPasswordStatus();
    }

    private async Task CheckMasterPasswordStatus()
    {
        try
        {
            var response = await HttpClient.GetAsync("auth/masterpassword/isset");
            if (response.IsSuccessStatusCode)
            {
                var isSet = await response.Content.ReadFromJsonAsync<bool>();
                masterPassword = isSet ? "set" : null; // Dummy value
            }
        }
        catch
        {
            // Ignore errors
        }
    }

    private void OpenMasterPasswordModal()
    {
        masterPasswordError = "";
        newMasterPassword = "";
        enteredMasterPassword = "";
        masterPasswordModal?.Open();
    }

    private void CloseMasterPasswordModal()
    {
        masterPasswordModal?.Close();
    }

    private async Task SetMasterPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(newMasterPassword))
        {
            masterPasswordError = "Password cannot be empty";
            return;
        }

        try
        {
            var response = await HttpClient.PostAsJsonAsync("auth/masterpassword/set", new { MasterPassword = newMasterPassword });
            if (response.IsSuccessStatusCode)
            {
                // Clear session verification since password changed
                await sessionStorage.RemoveItemAsync("masterPasswordVerified");
                await CheckMasterPasswordStatus();
                masterPasswordModal?.Close();
            }
            else
            {
                masterPasswordError = "Failed to set master password";
            }
        }
        catch
        {
            masterPasswordError = "Error setting master password";
        }
    }

    private async Task VerifyMasterPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(enteredMasterPassword))
        {
            masterPasswordError = "Password cannot be empty";
            return;
        }

        try
        {
            var response = await HttpClient.PostAsJsonAsync("auth/masterpassword/verify", new { MasterPassword = enteredMasterPassword });
            if (response.IsSuccessStatusCode)
            {
                // Set in session that master password is verified
                await sessionStorage.SetItemAsync("masterPasswordVerified", true);
                masterPasswordModal?.Close();
                // TODO: Notify other components that groups are unlocked
            }
            else
            {
                masterPasswordError = "Incorrect master password";
            }
        }
        catch
        {
            masterPasswordError = "Error verifying master password";
        }
    }

    private async Task StartEditMasterPassword()
    {
        // Verify current password first
        if (string.IsNullOrWhiteSpace(enteredMasterPassword))
        {
            masterPasswordError = "Enter current password first";
            return;
        }

        try
        {
            var response = await HttpClient.PostAsJsonAsync("auth/masterpassword/verify", new { MasterPassword = enteredMasterPassword });
            if (response.IsSuccessStatusCode)
            {
                // Switch to set new password mode
                masterPassword = null;
                newMasterPassword = "";
                enteredMasterPassword = "";
                masterPasswordError = "";
                // The modal will now show the "Set Password" UI
            }
            else
            {
                masterPasswordError = "Incorrect password";
            }
        }
        catch
        {
            masterPasswordError = "Error verifying password";
        }
    }
}
