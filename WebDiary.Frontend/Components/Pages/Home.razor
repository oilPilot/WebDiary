@page "/"
@inject IStringLocalizer<Resources.MainResource> Localizator

<PageTitle>MyDiary</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>@Localizator["HomeHeadAuth"]@context.User.Identity!.Name!</h1>
    </Authorized>
    <NotAuthorized>
        <h1>@Localizator["HomeHeadNonAuth"]</h1>
    </NotAuthorized>
</AuthorizeView>

<div id="settings" class="align-items-center">
    <p>@Localizator["SettingsText"]</p>
    <div class="d-flex align-items-center ms-2">
        <SelectLanguage />
        <div class="ms-4" />
        <ThemeSwitch />
    </div>
</div>

<div id="experimental" class="align-items-center">
    <p>@Localizator["ExperimentalSettingsText"]</p>
    <AuthorizeView>
        <Authorized>
            <div class="d-flex align-items-center ms-4">
                <ExperimentalPDFsave />
            </div>
        </Authorized>
        <NotAuthorized><p class="fw-bold">@Localizator["ExperimentalSettingsNonAuth"]</p></NotAuthorized>
    </AuthorizeView>
</div>

