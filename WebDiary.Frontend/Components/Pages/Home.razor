@page "/"
@using System.Security.Claims
@using WebDiary.Frontend.Models.Auth
@inject IStringLocalizer<Resources.MainResource> Localizator
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject HttpClient HttpClient
@inject DiaryGroupClient DiaryGroupClient
@inject UserClient UserClient

<PageTitle>MyDiary</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>@Localizator["HomePageTitleAuth"]@context.User.Identity!.Name!</h1>
        <div>
            <p>Experimental Features and Settings:</p>
            <div>
                <p>Saving as pdf group (no rich formatting):</p>
                <select @bind="selectedGroupId">
                    <option value="-1">All groups in one (groups are united)</option>
                    @if(groups != null) {
                        @foreach(DiaryGroup group in groups) {
                            <option value="@group.Id">@group.Name</option>
                        }
                    }
                </select>
                <button class="btn btn-secondary" @onclick="SaveAsPdf">Save as PDF</button>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <h1>@Localizator["HomePageTitleNoAuth"]</h1>
    </NotAuthorized>
</AuthorizeView>
<p>@Localizator["HomePageText"]</p>
@*Should Change EVERYTHING there, that's will be next task*@

@code {
    List<DiaryGroup>? groups;
    int loggedUserId;
    int selectedGroupId;
    
    protected async override Task OnAfterRenderAsync(bool firstRender) {
        if(firstRender) {
            var loggedUser = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

            if(loggedUser.Identity != null && loggedUser.Identity.IsAuthenticated) {
                loggedUserId = Convert.ToInt32(loggedUser.FindFirstValue("userId"));
                groups = await DiaryGroupClient.GetGroupsOfUserAsync(loggedUserId);
            }

            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task SaveAsPdf() {
        if(selectedGroupId == 0) {
            await JS.InvokeVoidAsync("open", $"{HttpClient.BaseAddress}export/all/{loggedUserId}", "_blank");
        } else {
            await JS.InvokeVoidAsync("open", $"{HttpClient.BaseAddress}export/certain/{selectedGroupId}", "_blank");
        }
    }
}