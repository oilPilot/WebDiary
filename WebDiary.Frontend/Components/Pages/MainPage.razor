@page "/Diary/{id:int}"
@using System.Security.Claims
@using System.Text.Json
@using Blazored.LocalStorage
@inject DiaryClient DiaryClient
@inject DiaryGroupClient DiaryGroupClient
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserClient UserClient
@inject HttpClient HttpClient
@inject IStringLocalizer<Resources.MainResource> Localizator
@inject ILocalStorageService localStorage
@inject IJSRuntime JS

<PageTitle>MyDiary</PageTitle>

<AuthorizeView Context="diaryContext">
    <Authorized>
        <DialogueTemplate @ref="modalPin" HeaderText=@Localizator["CheckPinHeader"]>
            <BodyTemplate>
                    <p>@Localizator["CheckPinGroup1"]</p>
                    <InputText type="password"  class="full-width" @bind-Value="PinCode"></InputText>
            </BodyTemplate>
            <FooterTemplate>
                    <p class="fs-5 fw-semibold text-danger">@ErrorMessage</p>
                    <button type="button" class="btn btn-primary"
                        @onclick="TryCheckPinAsync">@Localizator["EnterButtonText"]</button>
            </FooterTemplate>
        </DialogueTemplate>

        @if(diaries is null) {
            <p>@Localizator["LoadingDiaries"]</p>
        } else {
            @if(PageTitle != "PIN") {
                if(@isValidated) {
                    <h1>@PageTitle</h1>
                    <div>
                        @foreach(var date in diaries.GroupBy(diary => diary.Date).OrderBy(date => date.Key)
                                                        .Select(diary => diary.First().Date)) {
                            <ol>
                                <p>@date
                                <button class="btn btn-outline-primary" data-bs-toggle="collapse"
                                    data-bs-target="#@date">@Localizator["CollapseInMainPage"]</button>
                                </p>
                            @foreach(var diary in diaries.Where(diary => diary.Date == date)) {
                                <li class="ms-2 collapse nonumeration" id="@date">
                                    <ol>
                                        <p>@diary.Time @diary.mood
                                        <button class="btn btn-outline-secondary" data-bs-toggle="collapse"
                                            data-bs-target="#@diary.Id">@Localizator["CollapseInMainPage"]</button>
                                        </p>
                                        <li class="ms-4 nonumeration collapse" id="@diary.Id">
                                            <p class="new-line-work">@((MarkupString)diary.Text)</p>
                                        </li>
                                    </ol>
                                </li>
                            }
                            </ol>
                        }
                    </div>
                    <EditForm Model="diary" OnValidSubmit="AddDiaryAsync" FormName="SendDiary" class="footer" @onchange="SaveTextInForm" @oninput="SaveTextInForm">
                        <div class="mb-2 me-2 ms-2" style="height: 100px;">
                            <BlazoredTextEditor @ref="@richEditor" Placeholder="Please, enter what you think currently">
                                <ToolbarContent>
                                    <select class="ql-header">
                                        <option selected=""></option>
                                        <option value="1"></option>
                                        <option value="2"></option>
                                        <option value="5"></option>
                                    </select>
                                    <span class="ql-formats">
                                        <button class="ql-bold"></button>
                                        <button class="ql-italic"></button>
                                        <button class="ql-underline"></button>
                                        <button class="ql-strike"></button>
                                    </span>
                                    <span class="ql-formats">
                                        <select class="ql-color"></select>
                                        <select class="ql-background"></select>
                                    </span>
                                    <span class="ql-formats">
                                        <button class="ql-list" value="ordered"></button>
                                        <button class="ql-list" value="bullet"></button>
                                    </span>
                                    <span class="ql-formats">
                                        <button class="ql-link"></button>
                                    </span>
                                </ToolbarContent>
                                <EditorContent>
                                    
                                </EditorContent>
                            </BlazoredTextEditor>
                            <div>
                                <button class="btn btn-secondary ms-2" type="submit">@Localizator["MainPageButtonText"]</button>
                                <select @bind="diary!.mood">
                                    <option value="—">you can select mood</option>
                                    <option value="🙂">🙂</option>
                                    <option value="😁">😁</option>
                                    <option value="😌">😌</option>
                                    <option value="🤔">🤔</option>
                                    <option value="😴">😴</option>
                                    <option value="😐">😐</option>
                                    <option value="😥">😥</option>
                                    <option value="😳">😳</option>
                                    <option value="😔">😔</option>
                                    <option value="😤">😤</option>
                                    <option value="😱">😱</option>
                                    <option value="🤬">🤬</option>
                                    <option value="(^▽^)">(^▽^)</option>
                                    <option value="(づ｡ ◕‿‿◕｡) づ">(づ｡ ◕‿‿◕｡) づ</option>
                                </select>
                            </div>
                        </div>
                    </EditForm>
                } else {
                    <PageTitle>Diary - @Localizator["NotValidatedTitle"]</PageTitle>
                    <h1>@Localizator["NotValidatedTitle"]</h1>
                    <p>@Localizator["NotValidatedText"]</p>
                }
            }
        }
    </Authorized>
    <NotAuthorized>
        <PageTitle>Diary - @Localizator["UnathorizedTitle"]</PageTitle>
        <h1>@Localizator["UnathorizedTitle"]</h1>
        <p>@Localizator["UnathorizedText"]</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public int? id { get; set; }
    public BlazoredTextEditor richEditor { get; set;} = new();
    private DialogueTemplate? modalPin;

    private List<Diary>? diaries;
    private Diary? diary;
    private DiaryGroup? group;
    public string? PageTitle;
    private bool isValidated;
    [CascadingParameter] protected Task<AuthenticationState>? AuthStat { get; set; }

    protected override async Task OnInitializedAsync() {
        if(id is null)
            throw new Exception("id in Diaries page is null.");
        diary ??= new() {
            Text = "",
            GroupId = id!.Value
        };
        await base.OnInitializedAsync();

        var User = (await AuthStat!).User;
        if(User.Identity != null && User.Identity.IsAuthenticated) {
            int loggedUserId = Convert.ToInt32(User.FindFirstValue("userId"));
            User user = await UserClient.GetUserByIdAsync(loggedUserId);
            isValidated = user.IsValidated;
        } else {
            NavigationManager.NavigateTo("/Users/Login");
        }
    }

    protected override async Task OnParametersSetAsync() {
        if(id is null)
            throw new Exception("id in Diaries page is null.");
        try {
            group = await DiaryGroupClient.GetGroupAsync(id.Value);
            diary = new() {
                Text = "",
                GroupId = id!.Value
            };
            diaries = await DiaryClient.GetDiariesOfGroupAsync(group.Id);
            if (!string.IsNullOrEmpty(group.PinCode)) {
                modalPin!.Open();
                PageTitle = "PIN";
            } else {
                PageTitle = group.Name;
            }
        } catch (Exception Exception) {
            if(Exception.Message == "Response status code does not indicate success: 404 (Not Found).") {
                RedirectTo404();
            }
            Console.WriteLine(Exception);
        }
        await base.OnParametersSetAsync();
    }

    protected async override Task OnAfterRenderAsync(bool firstRender) {
        if(firstRender) {
            StateHasChanged();
            /*  It needs delay, or else richEditor will break because of null JSInterop (by some reason...)
                If i want to fix this shitty thingy, i will need to make Quill usage of myself entirely.
                Will probably do much later.
            */
            //await Task.Delay(600);
            //await LoadText();
        }

        await base.OnAfterRenderAsync(firstRender);
    }


    private async Task LoadText() {
        var autoSavedText = await localStorage.GetItemAsStringAsync("NewDiaryAutoSavedText");
        if(autoSavedText != null)
            await richEditor.LoadHTMLContent(autoSavedText);
    }

    private async Task SaveTextInForm() {
        await localStorage.SetItemAsStringAsync("NewDiaryAutoSavedText", await richEditor!.GetHTML());
    }

    private void RedirectTo404() {
        NavigationManager.NavigateTo("NotFoundResource");
    }

    private void CorrectPin() {
        PageTitle = group!.Name;
    }

    async Task AddDiaryAsync() {
        var js = await JS.InvokeAsync<JsonElement>("getClientTime");
        var isoUtc = js.GetProperty("isoUtc").GetString();
        
        var offset = js.GetProperty("offsetMinutes").GetInt32();
        if(isoUtc == null)
            isoUtc = "";
        var utc = DateTime.Parse(isoUtc, null, System.Globalization.DateTimeStyles.AdjustToUniversal);
        
        diary!.Text = await richEditor!.GetHTML();
        diary.CreatedUtc = utc;
        diary.UtcOffsetMinutes = offset;
        
        await DiaryClient.AddDiaryAsync(diary!);
        await localStorage.SetItemAsStringAsync("NewDiaryAutoSavedText", string.Empty);
        StateHasChanged();
        NavigationManager.Refresh(true);
    }

    // Modals Methods
    private string? ErrorMessage;
    private string? PinCode;

    private async Task TryCheckPinAsync() {
        ArgumentNullException.ThrowIfNull(group);

        var response = (await HttpClient.GetAsync($"/auth/pincode/isequal/{PinCode}/{group!.Id}?culture={CultureInfo.CurrentCulture}"));
        if(!response.IsSuccessStatusCode) {
            ErrorMessage = Localizator["IncorrectPinText"];
            return;
        }

        CorrectPin();
        modalPin!.Close();
    }

}

