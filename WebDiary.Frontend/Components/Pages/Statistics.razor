@page "/Statistics"
@using Plotly.Blazor
@using Plotly.Blazor.LayoutLib
@using Plotly.Blazor.Traces
@using System.Drawing
@inject IStringLocalizer<Resources.MainResource> Localizator
@inject HttpClient HttpClient

<AuthorizeView>
    <Authorized>
        <h3>@Localizator["StatisticsHeader"]</h3>
        <div class="d-flex">
            <p>@Localizator["DateRangePick"]</p>
            <DateRangePicker class="ms-2 form-control-sm" @bind-StartDate="startDate" @bind-EndDate="endDate" />
            <button class="btn btn-primary ms-2" @onclick="LoadStatsForDates">@Localizator["LoadStatistics"]</button>
        </div>
        @if(statsForDates != null)
        {
            <p class="mt-3">@Localizator["StatisticsTableData1"]</p>
            <TableTemplate Items="statsForDates">
                <TableHeader>
                    <th>@Localizator["StatisticsTableData2"]</th>
                    <th>@Localizator["StatisticsTableData3"]</th>
                    <th>@Localizator["StatisticsTableData4"]</th>
                    <th>@Localizator["StatisticsTableData5"]</th>
                    <th>@Localizator["StatisticsTableData6"]</th>
                </TableHeader>
                <RowTemplate Context="statsForDay">
                    <td>@statsForDay.Date</td>
                    <td>@statsForDay.EntriesCount</td>
                    <td>@statsForDay.SymbolsCount</td>
                    <td>@statsForDay.AvgSymbolsPerEntry</td>
                    <td>@statsForDay.MoodPointChange</td>
                </RowTemplate>
                <TableBottom>
                    <td><strong>@Localizator["StatisticsTableData7"]</strong></td>
                    <td><strong>@totalStats?.EntriesCount</strong></td>
                    <td><strong>@totalStats?.SymbolsCount</strong></td>
                    <td><strong>@totalStats?.AvgSymbolsPerEntry</strong></td>
                    <td><strong>@totalStats?.MoodPointChange</strong></td>
                </TableBottom>
            </TableTemplate>
            @if(statsForDates.Count == 0)
            {
                <p class="mt-3 text-danger">@Localizator["NoData"]</p>
            }
            @if(statsForDates.Count > 5)
            {
                <div class="mt-5 d-flex" style="min-height: 400px;">
                    <button class="btn btn-secondary ms-2" @onclick="LoadLinearChart">@Localizator["LoadChart"]</button>
                    @if(data != null)
                    {
                        <PlotlyChart @bind-Config="config" @bind-Layout="layout" @bind-Data="data" @ref="chart"></PlotlyChart>
                    }
                </div>
            } else {
                <p class="mt-3 text-warning">@Localizator["NotEnoughDataForChart"]</p>
            }
        }
    </Authorized>
</AuthorizeView>

@code {
    int loggedUserId;
    List<StatsDay>? statsForDates;
    DateTimeOffset? startDate = DateTime.Now.AddMonths(-1);
    DateTimeOffset? endDate = DateTime.Now;
    StatsDay? totalStats;
    [CascadingParameter] protected Task<AuthenticationState>? AuthStat { get; set; }
    PlotlyChart? chart;
    Config? config;
    Layout? layout;
    IList<ITrace>? data;

    protected async override Task OnInitializedAsync()
    {
        base.OnInitialized();

        var user = (await AuthStat!).User;
        if(user.Identity != null && user.Identity.IsAuthenticated)
        {
            loggedUserId = Convert.ToInt32(user.FindFirstValue("userId"));
        }
    }
    private async Task LoadStatsForDates()
    {
        try {
            var requestUri = $"stats/fordates?userId={loggedUserId}&startDate={startDate?.ToString("yyyy-MM-dd")}&endDate={endDate?.ToString("yyyy-MM-dd")}";
            var response = await HttpClient.GetAsync(requestUri);
            if(response.IsSuccessStatusCode)
            {
                statsForDates = await response.Content.ReadFromJsonAsync<List<StatsDay>>();
                totalStats = new StatsDay
                {
                    Date = DateOnly.FromDateTime(DateTime.MinValue),
                    EntriesCount = statsForDates!.Sum(s => s.EntriesCount),
                    SymbolsCount = statsForDates!.Sum(s => s.SymbolsCount),
                    AvgSymbolsPerEntry = statsForDates!.Sum(s => s.EntriesCount) != 0 ? statsForDates!.Sum(s => s.SymbolsCount) / statsForDates!.Sum(s => s.EntriesCount) : 0,
                    MoodPointChange = statsForDates!.Sum(s => s.MoodPointChange)
                };
            }
        }
        catch(Exception ex)
        {
            System.Console.WriteLine("Exception occurred while loading stats for dates.");
        }
    }

    private void LoadLinearChart()
    {
        // Initialize chart properties
        config = new Config();
        config.Responsive = true;
        config.DisplayLogo = false;

        // Define layout properties as needed
        layout = new Layout();
        //layout.Title = new Title { Text = "Linear Chart Example", Color = Color.DarkBlue };
        // Define data
        List<object> dates = statsForDates.Select(s => s.Date.ToString("yyyy-MM-dd")).Cast<object>().ToList();
        List<object> entriesCounts = statsForDates.Select(s => s.EntriesCount).Cast<object>().ToList();
        var symbolsCounts = statsForDates.Select(s => s.SymbolsCount).Cast<object>().ToList();
        var avgSymbolsPerEntry = statsForDates.Select(s => s.AvgSymbolsPerEntry).Cast<object>().ToList();
        var moodPointChanges = statsForDates.Select(s => s.MoodPointChange).Cast<object>().ToList();

        Scatter scatterEntries = new Scatter() {
            Name = Localizator["StatisticsTableData3"],
            Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.Lines | Plotly.Blazor.Traces.ScatterLib.ModeFlag.Markers,
            X = dates,
            Y = entriesCounts,
            FillColor = Color.Green
        };
        Scatter scatterSymbols = new Scatter() {
            Name = Localizator["StatisticsTableData4"],
            Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.Lines | Plotly.Blazor.Traces.ScatterLib.ModeFlag.Markers,
            X = dates,
            Y = symbolsCounts,
            FillColor = Color.Black
        };

        Scatter scatterAvgSymbols = new Scatter() {
            Name = Localizator["StatisticsTableData5"],
            Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.Lines | Plotly.Blazor.Traces.ScatterLib.ModeFlag.Markers,
            X = dates,
            Y = avgSymbolsPerEntry,
            FillColor = Color.Azure
        };

        Scatter scatterMood = new Scatter() {
            Name = Localizator["StatisticsTableData6"],
            Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.Lines | Plotly.Blazor.Traces.ScatterLib.ModeFlag.Markers,
            X = dates,
            Y = moodPointChanges,
            FillColor = Color.Orange
        };

        data = new List<ITrace>
        {
            scatterEntries,
            scatterSymbols,
            scatterAvgSymbols,
            scatterMood
        };
    }
}