@page "/Statistics"
@using Plotly.Blazor
@using Plotly.Blazor.LayoutLib
@using Plotly.Blazor.Traces
@using System.Drawing
@inject IStringLocalizer<Resources.MainResource> Localizator
@inject HttpClient HttpClient
@inject StatsClient statsClient

<AuthorizeView>
    <Authorized>
        <div class="container-fluid py-4">
            <div class="row justify-content-center">
                <div class="col-lg-10 col-xl-8">
                    <!-- Header -->
                    <div class="text-center mb-4">
                        <h2 class="display-6 fw-bold text-primary mb-2">
                            <i class="bi bi-bar-chart-line-fill me-3"></i>
                            @Localizator["StatisticsHeader"]
                        </h2>
                        <p class="text-muted mb-0">Analyze your writing patterns and mood trends</p>
                    </div>

                    <!-- Date Range Selector -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-calendar-range text-primary me-2"></i>
                                @Localizator["DateRangePick"]
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row align-items-end g-3">
                                <div class="col-md-8">
                                    <label class="form-label">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        Select Date Range
                                    </label>
                                    <DateRangePicker class="form-control" @bind-StartDate="startDate" @bind-EndDate="endDate" />
                                </div>
                                <div class="col-md-4">
                                    <button class="btn btn-primary w-100" @onclick="LoadStatsForDates">
                                        <i class="bi bi-graph-up me-1"></i>
                                        @Localizator["LoadStatistics"]
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if(statsForDates != null)
                    {
                        <!-- Statistics Table -->
                        <div class="card shadow-sm mb-4">
                            <div class="card-header bg-light">
                                <h5 class="card-title mb-0">
                                    <i class="bi bi-table text-info me-2"></i>
                                    @Localizator["StatisticsTableData1"]
                                </h5>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <TableTemplate Items="statsForDates">
                                        <TableHeader>
                                            <th class="bg-light fw-semibold">
                                                <i class="bi bi-calendar me-1"></i>
                                                @Localizator["StatisticsTableData2"]
                                            </th>
                                            <th class="bg-light fw-semibold">
                                                <i class="bi bi-journal-text me-1"></i>
                                                @Localizator["StatisticsTableData3"]
                                            </th>
                                            <th class="bg-light fw-semibold">
                                                <i class="bi bi-type me-1"></i>
                                                @Localizator["StatisticsTableData4"]
                                            </th>
                                            <th class="bg-light fw-semibold">
                                                <i class="bi bi-calculator me-1"></i>
                                                @Localizator["StatisticsTableData5"]
                                            </th>
                                            <th class="bg-light fw-semibold">
                                                <i class="bi bi-emoji-expressionless me-1"></i>
                                                @Localizator["StatisticsTableData6"]
                                            </th>
                                        </TableHeader>
                                        <RowTemplate Context="statsForDay">
                                            <td>@statsForDay.Date</td>
                                            <td>@statsForDay.EntriesCount</td>
                                            <td>@statsForDay.SymbolsCount</td>
                                            <td>@statsForDay.AvgSymbolsPerEntry</td>
                                            <td>@statsForDay.MoodPointChange</td>
                                        </RowTemplate>
                                        <TableBottom>
                                            <td class="fw-bold bg-light">
                                                <i class="bi bi-trophy me-1 text-warning"></i>
                                                @Localizator["StatisticsTableData7"]
                                            </td>
                                            <td class="fw-bold">@totalStats?.EntriesCount</td>
                                            <td class="fw-bold">@totalStats?.SymbolsCount</td>
                                            <td class="fw-bold">@totalStats?.AvgSymbolsPerEntry</td>
                                            <td class="fw-bold">@totalStats?.MoodPointChange</td>
                                        </TableBottom>
                                    </TableTemplate>
                                </div>
                            </div>
                        </div>

                        @if(statsForDates.Count == 0)
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                @Localizator["NoData"]
                            </div>
                        }

                        @if(statsForDates.Count > 5)
                        {
                            <!-- Chart Section -->
                            <div class="card shadow-sm">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">
                                        <i class="bi bi-graph-up text-success me-2"></i>
                                        Visual Analytics
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="d-flex justify-content-center mb-3">
                                        <button class="btn btn-success" @onclick="LoadLinearChart">
                                            <i class="bi bi-bar-chart-line me-1"></i>
                                            Generate Chart
                                        </button>
                                    </div>
                                    @if(data != null)
                                    {
                                        <div class="border rounded p-3" style="min-height: 400px;">
                                            <PlotlyChart @bind-Config="config" @bind-Layout="layout" @bind-Data="data" @ref="chart"></PlotlyChart>
                                        </div>
                                    }
                                </div>
                            </div>
                        } else if(statsForDates.Count > 0) {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle-fill me-2"></i>
                                @Localizator["NotEnoughDataForChart"]
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    int loggedUserId;
    List<StatsDay>? statsForDates;
    DateTimeOffset? startDate = DateTime.Now.AddMonths(-1);
    DateTimeOffset? endDate = DateTime.Now;
    StatsDay? totalStats;
    [CascadingParameter] protected Task<AuthenticationState>? AuthStat { get; set; }
    PlotlyChart? chart;
    Config? config;
    Layout? layout;
    IList<ITrace>? data;

    protected async override Task OnInitializedAsync()
    {
        base.OnInitialized();

        var user = (await AuthStat!).User;
        if(user.Identity != null && user.Identity.IsAuthenticated)
        {
            loggedUserId = Convert.ToInt32(user.FindFirstValue("userId"));
        }
    }
    private async Task LoadStatsForDates()
    {
        try {
            var response = await statsClient.GetStatisticsAsync(loggedUserId, startDate, endDate);
            if(response.IsSuccessStatusCode)
            {
                statsForDates = await response.Content.ReadFromJsonAsync<List<StatsDay>>();
                totalStats = new StatsDay
                {
                    Date = DateOnly.FromDateTime(DateTime.MinValue),
                    EntriesCount = statsForDates!.Sum(s => s.EntriesCount),
                    SymbolsCount = statsForDates!.Sum(s => s.SymbolsCount),
                    AvgSymbolsPerEntry = statsForDates!.Sum(s => s.EntriesCount) != 0 ? statsForDates!.Sum(s => s.SymbolsCount) / statsForDates!.Sum(s => s.EntriesCount) : 0,
                    MoodPointChange = statsForDates!.Sum(s => s.MoodPointChange)
                };
            }
        }
        catch(Exception ex)
        {
            Log.Error("Exception occurred while loading stats for dates. Exception message: " + ex);
        }
    }

    private void LoadLinearChart()
    {
        // Initialize chart properties
        config = new Config();
        config.Responsive = true;
        config.DisplayLogo = false;

        // Define layout properties as needed
        layout = new Layout() {
            PlotBgColor = "rgba(0,0,0,0)",
            PaperBgColor = "rgba(0,0,0,0)",
            ModeBar = new Plotly.Blazor.LayoutLib.ModeBar
            {
                BgColor = "rgba(0,0,0,0)"
            }
        };
        // Define data
        if(statsForDates == null)
            return;
        List<object> dates = statsForDates.Select(s => s.Date.ToString("yyyy-MM-dd")).Cast<object>().ToList();
        List<object> entriesCounts = statsForDates.Select(s => s.EntriesCount).Cast<object>().ToList();
        var symbolsCounts = statsForDates.Select(s => s.SymbolsCount).Cast<object>().ToList();
        var avgSymbolsPerEntry = statsForDates.Select(s => s.AvgSymbolsPerEntry).Cast<object>().ToList();
        var moodPointChanges = statsForDates.Select(s => s.MoodPointChange).Cast<object>().ToList();

        Scatter scatterEntries = new Scatter() {
            Name = Localizator["StatisticsTableData3"],
            Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.Lines | Plotly.Blazor.Traces.ScatterLib.ModeFlag.Markers,
            X = dates,
            Y = entriesCounts,
            FillColor = Color.Green
        };
        Scatter scatterSymbols = new Scatter() {
            Name = Localizator["StatisticsTableData4"],
            Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.Lines | Plotly.Blazor.Traces.ScatterLib.ModeFlag.Markers,
            X = dates,
            Y = symbolsCounts,
            FillColor = Color.Black
        };

        Scatter scatterAvgSymbols = new Scatter() {
            Name = Localizator["StatisticsTableData5"],
            Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.Lines | Plotly.Blazor.Traces.ScatterLib.ModeFlag.Markers,
            X = dates,
            Y = avgSymbolsPerEntry,
            FillColor = Color.Azure
        };

        Scatter scatterMood = new Scatter() {
            Name = Localizator["StatisticsTableData6"],
            Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.Lines | Plotly.Blazor.Traces.ScatterLib.ModeFlag.Markers,
            X = dates,
            Y = moodPointChanges,
            FillColor = Color.Orange
        };

        data = new List<ITrace>
        {
            scatterEntries,
            scatterSymbols,
            scatterAvgSymbols,
            scatterMood
        };
    }
}