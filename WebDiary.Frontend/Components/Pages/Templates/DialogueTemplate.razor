@using BootstrapBlazor.Components

<div class="modal fade show" tabindex="-1" style="display: @ModalDisplay;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    @HeaderText
                </h5>
                <button type="button" class="btn-close btn-close-white" data-dismiss="modal" aria-label="Close" @onclick="() => Close()" />
            </div>
            <div class="modal-body p-4">
                @BodyTemplate
            </div>
            <div class="modal-footer bg-light">
                @FooterTemplate
            </div>
        </div>
    </div>
</div>

@if (ShowBackdrop)
{
    <div class="modal-backdrop fade show" />
}

@code {
    [Parameter]
    public required string HeaderText { get; set; }
    [Parameter]
    public required RenderFragment BodyTemplate { get; set; }
    [Parameter]
    public required RenderFragment FooterTemplate { get; set; }
    /// <summary>
    /// Adds custom code before opening (you can add whenever needed)
    /// </summary>
    [Parameter]
    public EventCallback CustomOpen { get; set; } = new EventCallback();
    /// <summary>
    /// Adds custom code before closing (you can add whenever needed)
    /// </summary>
    [Parameter]
    public EventCallback CustomClose { get; set; } = new EventCallback();
    // Modal visibility control Basics
    public string ModalDisplay = "none;";
    public bool ShowBackdrop = false;

    public void Open() {
        CustomOpen.InvokeAsync();
        ModalDisplay = "block;";
        ShowBackdrop = true;
        StateHasChanged();
    }
    public void Close() {
        CustomClose.InvokeAsync();
        ModalDisplay = "none;";
        ShowBackdrop = false;
        StateHasChanged();
    }

}
