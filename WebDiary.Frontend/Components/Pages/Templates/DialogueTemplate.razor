@using BootstrapBlazor.Components

<div class="modal" tabindex="-1" style="display: @ModalDisplay;">
    <div class="modal-dialogue" role="document">
        <div class="modal-placement modal-content">
            <div class="modal-header">
                <h4 class="modal-title">@HeaderText</h4>
                <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close" @onclick="() => Close()" />
            </div>
            <div class="modal-body">
                @BodyTemplate
            </div>
            <div class="modal-footer">
                @FooterTemplate
            </div>
        </div>
    </div>
</div>

@if (ShowBackdrop)
{
    <div class="modal-backdrop fade show" />
}

@code {
    [Parameter]
    public required string HeaderText { get; set; }
    [Parameter]
    public required RenderFragment BodyTemplate { get; set; }
    [Parameter]
    public required RenderFragment FooterTemplate { get; set; }
    /// <summary>
    /// Adds custom code before opening (you can add whenever needed)
    /// </summary>
    [Parameter]
    public EventCallback CustomOpen { get; set; } = new EventCallback();
    /// <summary>
    /// Adds custom code before closing (you can add whenever needed)
    /// </summary>
    [Parameter]
    public EventCallback CustomClose { get; set; } = new EventCallback();
    // Modal visibility control Basics
    public string ModalDisplay = "none;";
    public bool ShowBackdrop = false;

    public void Open() {
        CustomOpen.InvokeAsync();
        ModalDisplay = "block;";
        ShowBackdrop = true;
        StateHasChanged();
    }
    public void Close() {
        CustomClose.InvokeAsync();
        ModalDisplay = "none;";
        ShowBackdrop = false;
        StateHasChanged();
    }

}
