@typeparam TItem

<div class="table-wrapper-scroll-y my-custom-scrollbar@(CssClassesToAdd != null ? " " + CssClassesToAdd : "")">
    <table class="table table-bordered table-stripped mb-0">
        <thead>
            <tr>
                @TableHeader
            </tr>
        </thead>
        <tbody>
            @if(Items == null) {
                <p>Loading Items...</p>
            } else {
                @foreach(var item in Items) {
                    <tr>
                        @RowTemplate(item)
                    </tr>
                }
            }
        </tbody>
        @if(TableBottom != null)
        {
            <tfoot>
                <tr>
                    @TableBottom
                </tr>
            </tfoot>
        }
    </table>
</div>

@code {
    [Parameter]
    public RenderFragment TableHeader { get; set; }
    [Parameter]
    public RenderFragment<TItem> RowTemplate { get; set; }
    [Parameter]
    public RenderFragment? TableBottom { get; set; }
    [Parameter]
    public IReadOnlyList<TItem> Items { get; set; }
    [Parameter]
    public string? CssClassesToAdd { get; set; }

}
