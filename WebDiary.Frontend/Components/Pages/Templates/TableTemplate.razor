@typeparam TItem

<div class="table-wrapper-scroll-y my-custom-scrollbar wd-table-shell@(CssClassesToAdd != null ? " " + CssClassesToAdd : "")">
    <table class="table table-striped table-hover align-middle wd-table">
        <thead>
            <tr>
                @TableHeader
            </tr>
        </thead>
        <tbody>
            @if(Items == null) {
                <tr class="wd-table-empty">
                    <td colspan="99">Loading items...</td>
                </tr>
            } else if(Items.Count == 0) {
                <tr class="wd-table-empty">
                    <td colspan="99">No items to display.</td>
                </tr>
            } else {
                @foreach(var item in Items) {
                    <tr>
                        @RowTemplate(item)
                    </tr>
                }
            }
        </tbody>
        @if(TableBottom != null)
        {
            <tfoot>
                <tr>
                    @TableBottom
                </tr>
            </tfoot>
        }
    </table>
</div>

@code {
    [Parameter]
    public required RenderFragment TableHeader { get; set; }
    [Parameter]
    public required RenderFragment<TItem> RowTemplate { get; set; }
    [Parameter]
    public RenderFragment? TableBottom { get; set; }
    [Parameter]
    public required IReadOnlyList<TItem> Items { get; set; }
    [Parameter]
    public string? CssClassesToAdd { get; set; }

}
