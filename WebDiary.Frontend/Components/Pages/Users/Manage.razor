@page "/Users"
@using System.Security.Claims
@using BootstrapBlazor.Components
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using WebDiary.Frontend.Model
@using WebDiary.Frontend.Models.Auth
@using WebDiary.Frontend.Clients
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserClient UserClient
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Resources.UsersResource> Localizator
@inject HttpClient HttpClient

<PageTitle>MyDiary</PageTitle>

<AuthorizeView>
    <Authorized>
        @if(@isHadRendered) {
            <div class="container-fluid py-4">
                <div class="row justify-content-center">
                    <div class="col-lg-10 col-xl-8">
                        <!-- Header Section -->
                        <div class="text-center mb-4">
                            <h2 class="display-6 fw-bold text-primary mb-2">
                                <i class="bi bi-person-circle me-3"></i>
                                @Localizator["ManageAccountTitle"]
                            </h2>
                            <p class="text-muted mb-0">Manage your account settings and preferences</p>
                        </div>

                        <!-- Account Info Card -->
                        <div class="card shadow-sm mb-4">
                            <div class="card-header bg-primary text-white">
                                <h5 class="card-title mb-0">
                                    <i class="bi bi-info-circle-fill me-2"></i>
                                    Account Information
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="border-start border-primary border-4 ps-3">
                                            <small class="text-muted d-block">Username</small>
                                            <strong class="fs-5">@context.User.Identity!.Name</strong>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="border-start border-info border-4 ps-3">
                                            <small class="text-muted d-block">Role</small>
                                            <span class="badge bg-info fs-6">@context.User.FindFirstValue(ClaimTypes.Role)</span>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="border-start border-success border-4 ps-3">
                                            <small class="text-muted d-block">Description</small>
                                            <p class="mb-0">@context.User.FindFirstValue(ClaimTypes.UserData)</p>
                                        </div>
                                    </div>
                                    @if(!@isValidated) {
                                        <div class="col-12">
                                            <div class="alert alert-warning mb-0">
                                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                                <strong>@Localizator["DeactivatedAccount"]</strong>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="card shadow-sm mb-4">
                            <div class="card-header bg-light">
                                <h5 class="card-title mb-0">
                                    <i class="bi bi-tools me-2"></i>
                                    Account Actions
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-2">
                                    <div class="col-md-6 col-lg-3">
                                        <button type="button" class="btn btn-outline-primary w-100 d-flex align-items-center justify-content-center py-3"
                                                @onclick="() => modalAccount!.Open()">
                                            <div class="text-center">
                                                <i class="bi bi-pencil-square fs-4 mb-1"></i>
                                                <div class="small">@Localizator["ModifyAcc"]</div>
                                            </div>
                                        </button>
                                    </div>
                                    <div class="col-md-6 col-lg-3">
                                        <button type="button" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center py-3"
                                                @onclick="Login">
                                            <div class="text-center">
                                                <i class="bi bi-box-arrow-in-right fs-4 mb-1"></i>
                                                <div class="small">@Localizator["IntoAnotherAcc"]</div>
                                            </div>
                                        </button>
                                    </div>
                                    <div class="col-md-6 col-lg-3">
                                        <button type="button" class="btn btn-outline-warning w-100 d-flex align-items-center justify-content-center py-3"
                                                @onclick="Logout">
                                            <div class="text-center">
                                                <i class="bi bi-box-arrow-right fs-4 mb-1"></i>
                                                <div class="small">@Localizator["Logout"]</div>
                                            </div>
                                        </button>
                                    </div>
                                    <div class="col-md-6 col-lg-3">
                                        <button type="button" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center py-3"
                                                @onclick="() => modalAccountDelete!.Open()">
                                            <div class="text-center">
                                                <i class="bi bi-trash-fill fs-4 mb-1"></i>
                                                <div class="small">@Localizator["DeleteAcc"]</div>
                                            </div>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Admin Actions (if admin) -->
                        <AuthorizeView Roles="Admin" Context="AdminContext">
                            <Authorized>
                                <div class="card shadow-sm border-danger mb-4">
                                    <div class="card-header bg-danger text-white">
                                        <h5 class="card-title mb-0">
                                            <i class="bi bi-shield-lock-fill me-2"></i>
                                            Administrator Actions
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <button class="btn btn-danger w-100 d-flex align-items-center justify-content-center py-3"
                                                        @onclick="() => SendTest()">
                                                    <div class="text-center">
                                                        <i class="bi bi-envelope-paper-fill fs-4 mb-1"></i>
                                                        <div class="small">Send Test Email</div>
                                                    </div>
                                                </button>
                                            </div>
                                            <div class="col-md-6">
                                                <button class="btn btn-danger w-100 d-flex align-items-center justify-content-center py-3"
                                                        @onclick="() => modalRemove?.Open()">
                                                    <div class="text-center">
                                                        <i class="bi bi-person-dash-fill fs-4 mb-1"></i>
                                                        <div class="small">@Localizator["RemoveAdminRights"]</div>
                                                    </div>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>
            </div>
        } else {
            <div class="d-flex justify-content-center align-items-center min-vh-50">
                <div class="text-center">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-muted">@Localizator["PrerenderedTextUponLoading"]</p>
                </div>
            </div>
        }
            
            <EditForm Model="@newUser" Context="AccountChangeContext" OnValidSubmit="UpdateAccountAsync" FormName="DeleteAccountForm">
                <DialogueTemplate @ref="modalAccount" HeaderText=@Localizator["UpdateAccountDialogueHeader"] CustomOpen="@OpenUpdatingAccount">
                    <BodyTemplate>
                        <div>
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <div class="mt-3">
                                <label>
                                    @Localizator["AskUsername"]
                                    <InputText @bind-value="newUser!.UserName" />
                                    <ValidationMessage For="() => newUser!.UserName" />
                                </label>
                            </div>
                            <div class="mt-3">
                                <label>
                                    @Localizator["AskSelfdescription"]
                                    <InputTextArea @bind-value="newUser.Description" class="no-resize" />
                                    <ValidationMessage For="() => newUser.Description" />
                                </label>
                            </div>
                            @*
                            <div class="mt-3">
                                <label>
                                    @Localizator["AskNewEmail"]
                                    <InputText @bind-value="newEmail" />
                                    <ValidationMessage For="() => newEmail" />
                                </label>
                            </div>
                            *@
                            <div class="mt-3">
                                <label>
                                    @Localizator["AskOldPassword"]
                                    <InputText type="password" @bind-value="newUser.Password" />
                                    <ValidationMessage For="() => newUser.Password" />
                                </label>
                            </div>
                            <div class="mt-3">
                                <label>
                                    @Localizator["AskNewPassword"]
                                    <InputText type="password" @bind-value="newPassword" />
                                    <ValidationMessage For="() => newPassword" />
                                </label>
                            </div>
                            <div>
                                <label>
                                    <p class="fs-5 fw-semibold text-danger">@ErrorMessage</p>
                                    @*@if(passwordForgot) {
                                        <p>@Localizator["PswdIncorrectDoYouForgot"]
                                            @Localizator["Restore1"]<a href="/Users/RestorePassword" class="link-info">@Localizator["AddressForSomething"]</a></p>
                                    }*@
                                </label>
                            </div>
                        </div>
                    </BodyTemplate>
                    <FooterTemplate>
                        <button type="button" class="btn btn-secondary" data-dismiss="modal" @onclick="() => modalAccount!.Close()">
                            <i class="bi bi-x-circle me-1"></i>@Localizator["CancelButtonText"]
                        </button>
                        <button type="submit" class="btn btn-primary" data-dismiss="modal">
                            <i class="bi bi-check-circle me-1"></i>@Localizator["SaveButtonText"]
                        </button>
                    </FooterTemplate>
                </DialogueTemplate>
            </EditForm>

            <DialogueTemplate @ref="modalAccountDelete" HeaderText=@Localizator["DeleteAccountDialogueHeader"]>
                <BodyTemplate>
                    <div class="text-center">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-1 mb-3"></i>
                        <p class="fs-5 fw-semibold text-danger mb-0">@Localizator["DeleteAccSure"]</p>
                    </div>
                </BodyTemplate>
                <FooterTemplate>
                    <button class="btn btn-secondary" data-dismiss="modal" @onclick="() => modalAccountDelete!.Close()">
                        <i class="bi bi-x-circle me-1"></i>@Localizator["CancelButtonText"]
                    </button>
                    <button class="btn btn-danger" data-dismiss="modal" @onclick="DeleteAccountAsync">
                        <i class="bi bi-trash-fill me-1"></i>@Localizator["DeleteButtonText"]
                    </button>
                </FooterTemplate>
            </DialogueTemplate>

            <AuthorizeView Roles="Admin" Context="AdminContext">
                <Authorized>
                    <DialogueTemplate @ref="modalRemove" HeaderText=@Localizator["RemoveAdminRightsHeader"]>
                        <BodyTemplate>
                            <div class="text-center">
                                <i class="bi bi-shield-slash-fill text-warning fs-1 mb-3"></i>
                                <p class="fs-5 fw-semibold text-danger mb-0">@Localizator["RemoveAdminRightsSure"]</p>
                            </div>
                        </BodyTemplate>
                        <FooterTemplate>
                            <button class="btn btn-secondary" data-dismiss="modal" @onclick="() => modalRemove!.Close()">
                                <i class="bi bi-x-circle me-1"></i>@Localizator["CancelButtonText"]
                            </button>
                            <button class="btn btn-warning" data-dismiss="modal" @onclick="RemoveAdminRightsAsync">
                                <i class="bi bi-shield-slash me-1"></i>@Localizator["Continue"]
                            </button>
                        </FooterTemplate>
                    </DialogueTemplate>
                </Authorized>
            </AuthorizeView>
    </Authorized>
</AuthorizeView>

@code {
    private int loggedUserId;
    private bool isValidated;
    private bool isHadRendered = false;
    private User user = new User() { UserName = ""};
    private DialogueTemplate? modalAccount;
    private DialogueTemplate? modalAccountDelete;
    private DialogueTemplate? modalRemove;
    [CascadingParameter] protected Task<AuthenticationState>? AuthStat { get; set; }
    
    protected async override Task OnInitializedAsync() {
        await base.OnInitializedAsync();
        var User = (await AuthStat!).User;
        if(User.Identity != null && User.Identity.IsAuthenticated) {
            loggedUserId = Convert.ToInt32(User.FindFirstValue("userId"));
            user = await UserClient.GetUserByIdAsync(loggedUserId);
            isValidated = user.IsValidated;
            isHadRendered = true;
        } else {
            NavigationManager.NavigateTo("/Users/Login");
        }
    }
    
    private async Task Logout() {
        await ((CustomAuthenticationStateProvider)AuthenticationStateProvider).LogoutUserAsync();
        Login();
    }

    private async Task SendTest() {
        var emailModel = new sendEmailModel() {
            To = "oilPilot <matveyeresko0@gmail.com>",
            Subject = "Hello oilPilot",
            Body = "Test Email from MyDiary Web Application"
        };
        await HttpClient.PostAsJsonAsync("/auth/sendEmail", emailModel);
    }

    private void Login() => NavigationManager.NavigateTo("/Users/Login");

    // Modal Methods and Data
    private User newUser = new User() { UserName = ""};
    [MinLength(8)]
    [MaxLength(64)]
    [Required(AllowEmptyStrings = true)]
    private string? newPassword;
    private string? ErrorMessage;
    //private bool passwordForgot = false;

    private void OpenUpdatingAccount() {
        newUser = user;
        newUser.Password = "";
    }
    
    private async Task ReLogin() {
        var response = await HttpClient.PostAsJsonAsync("/auth/jwttoken/login", new { Username = newUser!.UserName, Password = newUser.Password });
        if(response.IsSuccessStatusCode) {
            System.Text.Json.JsonElement result = await response.Content.ReadFromJsonAsync<dynamic>();
            var token = result.GetProperty("token").GetString();
            var refreshToken = result.GetProperty("refreshToken").GetString();
            if(token != null && refreshToken != null)
                await ((CustomAuthenticationStateProvider)AuthenticationStateProvider).LoginUserAsync(token!, refreshToken!);
        } else {
            var msg = await response.Content.ReadAsStringAsync();
            ErrorMessage = msg;
        }
    }
    private async Task UpdateAccountAsync() {
        ErrorMessage = "";
        var response = await ((CustomAuthenticationStateProvider)AuthenticationStateProvider).AuthorizedRequestAsync(() =>
            HttpClient.PostAsJsonAsync($"/auth/password/verify?culture={CultureInfo.CurrentCulture}",
                new { Password = newUser!.Password }));
        if( response.IsSuccessStatusCode ) {
            if(!String.IsNullOrEmpty(newPassword))
                newUser.Password = newPassword;
            //if(!String.IsNullOrEmpty(newEmail))
            //    newUser.Email = newEmail;
            await UserClient.UpdateUserAsync(newUser);
            await ReLogin();
            StateHasChanged();
            modalAccount.Close();
        } else {
            var msg = await response.Content.ReadAsStringAsync();
            ErrorMessage += msg;
            //passwordForgot = true;
        }
    }

    private async Task DeleteAccountAsync() {
        await UserClient.DeleteUserAsync(loggedUserId);
        await ((CustomAuthenticationStateProvider)AuthenticationStateProvider).LogoutUserAsync();
        NavigationManager.NavigateTo("/", true);
        return;
    }

    private async Task RemoveAdminRightsAsync() {
        var newUser = user;
        newUser.Role = "Default";
        await UserClient.UpdateUserAsync(newUser);
    }

}
