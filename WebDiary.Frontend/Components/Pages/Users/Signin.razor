@page "/Users/Signin"
@inject NavigationManager NavigationManager
@inject UserClient UserClient
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient HttpClient
@inject IStringLocalizer<Resources.UsersResource> Localizator

<PageTitle>MyDiary</PageTitle>

@if(String.IsNullOrEmpty(Message)) {
    <div class="container-fluid py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-lg border-0">
                    <div class="card-header bg-success text-white text-center py-4">
                        <i class="bi bi-person-plus-fill fs-1 mb-2"></i>
                        <h3 class="card-title mb-0">@Localizator["SignIn"]</h3>
                    </div>
                    <div class="card-body p-4">
                        <EditForm Model="user" OnValidSubmit="SignIn" FormName="SigninForm">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="alert alert-danger" />

                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="bi bi-person-fill text-primary me-1"></i>
                                    @Localizator["AskUsername"]
                                </label>
                                <InputText type="text" class="form-control form-control-lg" @bind-value="user!.UserName" placeholder="@Localizator["AskUsername"]" />
                                <ValidationMessage For="() => user.UserName" class="text-danger small mt-1" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="bi bi-key-fill text-warning me-1"></i>
                                    @Localizator["AskNewPassword"]
                                </label>
                                <InputText type="password" class="form-control form-control-lg" @bind-value="user.Password" placeholder="@Localizator["AskNewPassword"]" />
                                <ValidationMessage For="() => user.Password" class="text-danger small mt-1" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label">
                                    <i class="bi bi-card-text text-info me-1"></i>
                                    @Localizator["AskSelfdescription"]
                                </label>
                                <InputTextArea @bind-value="user.Description" class="form-control" rows="3" placeholder="@Localizator["AskSelfdescription"]" />
                                <ValidationMessage For="() => user.Description" class="text-danger small mt-1" />
                            </div>

                            @if(!string.IsNullOrEmpty(ErrorMessage)) {
                                <div class="alert alert-danger mb-3">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    @ErrorMessage
                                </div>
                            }

                            <div class="d-grid">
                                <button type="submit" class="btn btn-success btn-lg @ButtonDisabled">
                                    <span class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
                                    <i class="bi bi-person-plus me-1"></i>
                                    @Localizator["SignIn"]
                                </button>
                            </div>
                        </EditForm>
                        <div class="my-4 d-flex align-items-center">
                            <div class="flex-grow-1 border-top"></div>
                            <span class="px-3 text-muted small">@Localizator["OrContinueWith"]</span>
                            <div class="flex-grow-1 border-top"></div>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-outline-danger btn-lg" @onclick="() => BeginOAuth(google)">
                                <i class="bi bi-google me-2"></i>
                                @Localizator["ContinueWithGoogle"]
                            </button>
                            <button type="button" class="btn btn-outline-light btn-lg" @onclick="() => BeginOAuth(github)">
                                <i class="bi bi-github me-2"></i>
                                @Localizator["ContinueWithGitHub"]
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
} else {
    <div class="container-fluid py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-lg border-0">
                    <div class="card-body text-center p-5">
                        <i class="bi bi-check-circle-fill text-success fs-1 mb-3"></i>
                        <h4 class="text-success mb-3">Registration Successful!</h4>
                        <p class="fs-5 fw-semibold">@Message</p>
                        <p class="text-muted">Please check your email for account verification instructions.</p>
                        <a href="/Users/Login" class="btn btn-primary mt-3">
                            <i class="bi bi-box-arrow-in-right me-1"></i>
                            Go to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    /*
            <div class="mt-3">
                @Localizator["AskEmail"]
                <InputText class="form-full-width" @bind-value="user.Email" />
                <ValidationMessage For="() => user.Email" />
            </div>
    */
    private string google = "google";
    private string github = "github";
    [SupplyParameterFromForm]
    public User? user { get; set; }
    [SupplyParameterFromQuery(Name = "token")]
    private string? OAuthToken { get; set; }
    [SupplyParameterFromQuery(Name = "refreshToken")]
    private string? OAuthRefreshToken { get; set; }
    [SupplyParameterFromQuery]
    private string ErrorMessage { get; set; } = "";
    private string Message = "";
    private string ButtonDisabled = "";
    private bool OAuthLoginHandled = false;
    
    public async Task SignIn() {
        ButtonDisabled = "disabled";
        ErrorMessage = "";
        try
        {
            await UserClient.AddUserAsync(user!);
            Message = Localizator["ValidateMust"];
        }
        catch (InvalidOperationException ex) when (ex.Message == "UsernameAlreadyUsed")
        {
            ErrorMessage = Localizator["UsernameAlreadyUsed"];
            ButtonDisabled = "";
        }
        catch
        {
            ErrorMessage = Localizator["WrongOnBackend"];
            ButtonDisabled = "";
        }
    }

    protected override async Task OnInitializedAsync() {
        await base.OnInitializedAsync();
        user = new User() {
            UserName = "",
            Password = ""
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender || OAuthLoginHandled)
            return;
        if(string.IsNullOrWhiteSpace(OAuthToken) || string.IsNullOrWhiteSpace(OAuthRefreshToken))
            return;

        try
        {
            await ((CustomAuthenticationStateProvider)AuthStateProvider).LoginUserAsync(OAuthToken, OAuthRefreshToken);
            OAuthLoginHandled = true;
            NavigationManager.NavigateTo("/", true);
        }
        catch (InvalidOperationException)
        {
            // JS interop isn't available during prerender; try again after interactive render.
        }
    }

    private void BeginOAuth(string provider)
    {
        var apiBase = HttpClient.BaseAddress ?? new Uri(NavigationManager.BaseUri);
        var returnUrl = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).ToString();
        var culture = CultureInfo.CurrentCulture.Name;
        var oauthUri = new Uri(apiBase, $"auth/oauth/{provider}");
        var oauthUrl = $"{oauthUri}?returnUrl={Uri.EscapeDataString(returnUrl)}&culture={Uri.EscapeDataString(culture)}";
        NavigationManager.NavigateTo(oauthUrl, true);
    }

}
